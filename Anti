local function monitorCharacter(char)
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local originalHealth = hum.Health
    hum.HealthChanged:Connect(function(newHealth)
        if newHealth < originalHealth then
            lastHitTime = tick()
            if isAntiPunchEnabled and not isResetting then
                hum.Health = originalHealth 
            end
        else
            originalHealth = newHealth
        end
    end)
    
    hrp.ChildAdded:Connect(function(desc)
        if desc:IsA("BodyVelocity") or desc:IsA("LinearVelocity") or desc.Name == "KnockbackVelocity" then
            desc:Destroy()
            lastThrowTime = tick() 
        end
    end)
end

if Player.Character then monitorCharacter(Player.Character) end
Player.CharacterAdded:Connect(monitorCharacter)

local function executeSmartReset()
    if not isAntiCuffEnabled or isResetting then return end
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    isResetting = true 
    savedResetCFrame = char.HumanoidRootPart.CFrame
    
    local resetEvent = ReplicatedStorage:FindFirstChild("CharacterResetRequest", true)
    if resetEvent then resetEvent:FireServer() end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.Health = 0 end
end

Player.CharacterAdded:Connect(function(newChar)
    if savedResetCFrame and isResetting then
        local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            task.wait(0.1)
            hrp.CFrame = savedResetCFrame
            hrp.Anchored = false
            savedResetCFrame = nil
            task.wait(0.5)
            isResetting = false 
        end
    end
end)

