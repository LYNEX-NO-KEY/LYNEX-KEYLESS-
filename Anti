-- 5. الحلقة الأساسية
RunService.RenderStepped:Connect(function()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp then
        -- ✅ كشف HD Admin Fly
        isFlying = (hrp:FindFirstChild("HDAdminFlyForce") ~= nil) or (hrp:FindFirstChild("HDAdminFlyGyro") ~= nil)
        
        -- 🔥 حماية السرعة الأفقية (مطرقة) — نتجاهل القفز والـ Fly
        if isAntiPunchEnabled and not isFrozenByHit and not isFlying then
            local vel = hrp.AssemblyLinearVelocity
            local horizontalSpeed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
            local isJumping = math.abs(vel.Y) > 30
            if horizontalSpeed > VELOCITY_THRESHOLD and not isJumping then
                activateFreeze(hrp)
            end
        end
        
        -- التجميد (حماية مضاعفة) — بس لو مش Fly
        if isFrozenByHit and not isFlying then
            if tick() >= freezeEndTime then
                isFrozenByHit = false
                hrp.Anchored = false
                if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
                if hum.JumpPower == 0 and not isAntiJumpEnabled then hum.JumpPower = 50 end
                frozenHitCFrame = nil
            else
                if not frozenHitCFrame then
                    frozenHitCFrame = hrp.CFrame
                end
                
                hrp.Anchored = true
                hrp.CFrame = frozenHitCFrame
                
                hum.WalkSpeed = 0
                hum.JumpPower = 0
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
                
                -- ✅ نحذف BodyMover بس لو مش HDAdminFly
                for _, v in pairs(hrp:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
                        v:Destroy()
                    elseif v:IsA("BodyForce") or v:IsA("BodyAngularVelocity") or v:IsA("AngularVelocity") 
                        or v:IsA("BodyPosition") or v:IsA("AlignPosition")
                        or v:IsA("BodyGyro") or v:IsA("AlignOrientation") then
                        local n = v.Name:lower()
                        if not (n:find("hdadminfly") or n:find("fly")) then
                            v:Destroy()
                        end
                    end
                end
            end
        end
        
        if isAntiMoveEnabled then
            if not frozenCFrame then frozenCFrame = hrp.CFrame end
            hrp.CFrame = frozenCFrame
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        else
            frozenCFrame = nil
        end

        if isAntiSitEnabled then
            if hum.Sit then hum.Sit = false end
        end

        if isAntiJumpEnabled then
            hum.JumpPower = 0
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn and jumpBtn.Visible then jumpBtn.Visible = false end
            end
        else
            if hum.JumpPower < 50 and not hum.Sit and not isFrozenByHit then hum.JumpPower = 50 end
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn and not jumpBtn.Visible then jumpBtn.Visible = true end
            end
        end

        if (tick() - lastHitTime) > 0.5 and (tick() - lastThrowTime) > 0.5 then
            if not isAntiMoveEnabled then
                lastCFrame = hrp.CFrame
            end
        end

        -- ✅ مضاد الرمي يتوقف لو Fly
        local isThrowProtected = isAntiThrowEnabled and not isFlying and (tick() - lastThrowTime) < 0.4
        local isHitProtected = isAntiPunchEnabled and not isFlying and (tick() - lastHitTime) < 0.4

        if isThrowProtected then
            hrp.CFrame = lastCFrame 
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        elseif isHitProtected then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        local isRecentlyThrown = isAntiThrowEnabled and not isFlying and (tick() - lastThrowTime) < 1.0

        if isAntiCuffEnabled and not isResetting and not isRecentlyThrown and not isAntiMoveEnabled then
            local isSittingOnSeat = hum.Sit and hum.SeatPart ~= nil and (hum.SeatPart:IsA("Seat") or hum.SeatPart:IsA("VehicleSeat"))
            local isCuffed = false
            
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then
                    local p0 = v.Part0 or v.Attachment0
                    if p0 and p0.Parent ~= char and p0:FindFirstChildOfClass("Humanoid") then
                        isCuffed = true
                    end
                end
            end
            
            for _, tool in pairs(char:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("cuff") or tool.Name:lower():find("كلبش")) then
                    isCuffed = true
                end
            end
            
            if not isSittingOnSeat and not isAntiSitEnabled then
                if hrp.Anchored or hum.WalkSpeed <= 2 or hum.PlatformStand then
                    isCuffed = true
                end
            end
            
            if isCuffed then
                executeSmartReset()
                return
            end
        end
    end
end)

