RunService.RenderStepped:Connect(function()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp then
        if isAntiMoveEnabled then
            if not frozenCFrame then frozenCFrame = hrp.CFrame end
            hrp.CFrame = frozenCFrame
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        else
            frozenCFrame = nil
        end

        if isAntiSitEnabled then
            if hum.Sit then hum.Sit = false end
        end

        if isAntiJumpEnabled then
            hum.JumpPower = 0
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn and jumpBtn.Visible then jumpBtn.Visible = false end
            end
        else
            if hum.JumpPower < 50 and not hum.Sit then hum.JumpPower = 50 end
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn and not jumpBtn.Visible then jumpBtn.Visible = true end
            end
        end

        if (tick() - lastHitTime) > 0.5 and (tick() - lastThrowTime) > 0.5 then
            if not isAntiMoveEnabled then
                lastCFrame = hrp.CFrame
            end
        end

        local isHitProtected = isAntiPunchEnabled and (tick() - lastHitTime) < 0.4
        local isThrowProtected = isAntiThrowEnabled and (tick() - lastThrowTime) < 0.4

        if isHitProtected or isThrowProtected then
            hrp.CFrame = lastCFrame 
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        local isRecentlyThrown = isAntiThrowEnabled and (tick() - lastThrowTime) < 1.0

        if isAntiCuffEnabled and not isResetting and not isRecentlyThrown and not isAntiMoveEnabled then
            local isSittingOnSeat = hum.Sit and hum.SeatPart ~= nil and (hum.SeatPart:IsA("Seat") or hum.SeatPart:IsA("VehicleSeat"))
            local isCuffed = false
            
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then
                    local p0 = v.Part0 or v.Attachment0
                    if p0 and p0.Parent ~= char and p0:FindFirstChildOfClass("Humanoid") then
                        isCuffed = true
                    end
                end
            end
            
            for _, tool in pairs(char:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("cuff") or tool.Name:lower():find("كلبش")) then
                    isCuffed = true
                end
            end
            
            if not isSittingOnSeat and not isAntiSitEnabled then
                if hrp.Anchored or hum.WalkSpeed <= 2 or hum.PlatformStand then
                    isCuffed = true
                end
            end
            
            if isCuffed then
                executeSmartReset()
                return
            end
        end
    end
end)

