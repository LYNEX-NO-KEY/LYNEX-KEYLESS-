-- 2. دالة تفعيل التجميد
local function activateFreeze(hrp)
    local now = tick()
    if now - lastFreezeTime >= FREEZE_COOLDOWN then
        lastFreezeTime = now
        isFrozenByHit = true
        freezeEndTime = now + FREEZE_DURATION
        if hrp then
            frozenHitCFrame = hrp.CFrame
            hrp.Anchored = true
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        return true
    end
    return false
end

-- 3. مراقبة الشخصية
local function monitorCharacter(char)
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local lastHealth = hum.Health
    hum.HealthChanged:Connect(function(newHealth)
        local healthDrop = lastHealth - newHealth
        lastHealth = newHealth
        
        if healthDrop > 0 and newHealth > 0 then
            lastHitTime = tick()
            
            -- ✅ ما يتجمّد لو Fly
            if isAntiPunchEnabled and not isResetting and not isFlying then
                activateFreeze(hrp)
                
                local closestPlayer = nil
                local shortestDistance = 25
                
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= Player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (otherPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = otherPlayer
                        end
                    end
                end
                
                if closestPlayer and closestPlayer.Character then
                    local enemyChar = closestPlayer.Character
                    
                    local oldHL = enemyChar:FindFirstChild("AttackerHighlight")
                    if oldHL then oldHL:Destroy() end
                    
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "AttackerHighlight"
                    highlight.FillColor = Color3.fromRGB(0, 255, 255)
                    highlight.OutlineColor = Color3.fromRGB(0, 0, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = enemyChar
                    
                    task.delay(HIGHLIGHT_DURATION, function()
                        if highlight and highlight.Parent then
                            highlight:Destroy()
                        end
                    end)
                end
            end
        end
    end)
    
    hrp.ChildAdded:Connect(function(desc)
        -- ✅ نتجاهل HDAdminFly
        local n = desc.Name:lower()
        if n:find("hdadminfly") or n:find("fly") then return end
        
        if desc:IsA("BodyVelocity") or desc:IsA("LinearVelocity") or desc.Name == "KnockbackVelocity" then
            desc:Destroy()
            lastThrowTime = tick() 
        end
    end)
end

if Player.Character then monitorCharacter(Player.Character) end
Player.CharacterAdded:Connect(monitorCharacter)

-- 4. دالة الرست
local function executeSmartReset()
    if not isAntiCuffEnabled or isResetting then return end
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    isResetting = true 
    savedResetCFrame = char.HumanoidRootPart.CFrame
    
    local resetEvent = ReplicatedStorage:FindFirstChild("CharacterResetRequest", true)
    if resetEvent then resetEvent:FireServer() end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.Health = 0 end
end

Player.CharacterAdded:Connect(function(newChar)
    if savedResetCFrame and isResetting then
        local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            task.wait(0.1)
            hrp.CFrame = savedResetCFrame
            hrp.Anchored = false
            savedResetCFrame = nil
            task.wait(0.5)
            isResetting = false 
        end
    end
end)

