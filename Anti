-- ==================== السحب مع الالتصاق بالشاشة ====================
local dragging = false
local dragStart, startAbsPos, startRelPos

local function pointInRect(p, rectPos, rectSize)
    return p.X >= rectPos.X and p.X <= rectPos.X + rectSize.X
        and p.Y >= rectPos.Y and p.Y <= rectPos.Y + rectSize.Y
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    
    if pointInRect(input.Position, MinBtn.AbsolutePosition, MinBtn.AbsoluteSize) then return end
    
    dragging    = true
    dragStart   = input.Position
    startAbsPos = MainFrame.AbsolutePosition
    startRelPos = MainFrame.Position
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    
    local delta = input.Position - dragStart
    local newAbsX = startAbsPos.X + delta.X
    local newAbsY = startAbsPos.Y + delta.Y
    
    local cam = workspace.CurrentCamera
    local vp  = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local fSize = MainFrame.AbsoluteSize
    
    newAbsX = math.clamp(newAbsX, -(fSize.X - 60), vp.X - 60)
    newAbsY = math.clamp(newAbsY, 0, vp.Y - TITLE_H - 4)
    
    local relDeltaX = newAbsX - startAbsPos.X
    local relDeltaY = newAbsY - startAbsPos.Y
    
    MainFrame.Position = UDim2.new(
        startRelPos.X.Scale, startRelPos.X.Offset + relDeltaX,
        startRelPos.Y.Scale, startRelPos.Y.Offset + relDeltaY
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ==================== دالة التجميد ====================
local function activateFreeze(hrp)
    local now = tick()
    if now - lastFreezeTime >= FREEZE_COOLDOWN then
        lastFreezeTime = now
        isFrozenByHit  = true
        freezeEndTime  = now + FREEZE_DURATION
        if hrp then
            frozenHitCFrame = hrp.CFrame
            hrp.Anchored    = true
            hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        return true
    end
    return false
end

-- ==================== مراقبة الشخصية ====================
local function monitorCharacter(char)
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    antiJumpApplied   = false
    jumpSettingsSaved = false
    
    local lastHealth = hum.Health
    hum.HealthChanged:Connect(function(newHealth)
        local healthDrop = lastHealth - newHealth
        lastHealth = newHealth
        
        if healthDrop > 0 and newHealth > 0 then
            lastHitTime = tick()
            
            if isAntiPunchEnabled and not isResetting and not isFlying then
                if not hum.Sit then
                    activateFreeze(hrp)
                end
                
                local closestPlayer = nil
                local shortestDistance = 25
                
                for _, otherPlayer in pairs(Players:GetPlayers()) do
                    if otherPlayer ~= Player and otherPlayer.Character
                        and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (otherPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = otherPlayer
                        end
                    end
                end
                
                if closestPlayer and closestPlayer.Character then
                    local enemyChar = closestPlayer.Character
                    local oldHL = enemyChar:FindFirstChild("AttackerHighlight")
                    if oldHL then oldHL:Destroy() end
                    
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "AttackerHighlight"
                    highlight.FillColor = Color3.fromRGB(0, 255, 255)
                    highlight.OutlineColor = Color3.fromRGB(0, 0, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = enemyChar
                    
                    task.delay(HIGHLIGHT_DURATION, function()
                        if highlight and highlight.Parent then
                            highlight:Destroy()
                        end
                    end)
                end
            end
        end
    end)
    
    hrp.ChildAdded:Connect(function(desc)
        local n = desc.Name:lower()
        if n:find("hdadminfly") or n:find("fly") then return end
        if desc:IsA("BodyVelocity") or desc:IsA("LinearVelocity") or desc.Name == "KnockbackVelocity" then
            desc:Destroy()
            lastThrowTime = tick()
        end
    end)
end

if Player.Character then monitorCharacter(Player.Character) end
Player.CharacterAdded:Connect(monitorCharacter)

-- ==================== الرست الذكي ====================
local function executeSmartReset()
    if not isAntiCuffEnabled or isResetting then return end
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    isResetting = true
    savedResetCFrame = char.HumanoidRootPart.CFrame
    
    local resetEvent = ReplicatedStorage:FindFirstChild("CharacterResetRequest", true)
    if resetEvent then resetEvent:FireServer() end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then hum.Health = 0 end
end

Player.CharacterAdded:Connect(function(newChar)
    if savedResetCFrame and isResetting then
        local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            task.wait(0.1)
            hrp.CFrame = savedResetCFrame
            hrp.Anchored = false
            savedResetCFrame = nil
            task.wait(0.5)
            isResetting = false
        end
    end
end)

Player.Idled:Connect(function()
    if isAntiAFKEnabled then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

-- ==================== الحلقة الأساسية ====================
RunService.RenderStepped:Connect(function()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return end
    
    isFlying = (hrp:FindFirstChild("HDAdminFlyForce") ~= nil)
            or (hrp:FindFirstChild("HDAdminFlyGyro")  ~= nil)
    local isSeated = hum.Sit == true
    
    if isFrozenByHit and not isFlying and not isSeated then
        if tick() >= freezeEndTime then
            isFrozenByHit = false
            hrp.Anchored = false
            if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
            if hum.JumpPower == 0 and not isAntiJumpEnabled then hum.JumpPower = 50 end
            frozenHitCFrame = nil
        else
            if not frozenHitCFrame then frozenHitCFrame = hrp.CFrame end
            hrp.Anchored = true
            hrp.CFrame   = frozenHitCFrame
            
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            hrp.Velocity    = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 0, 0)
            
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") then
                    v:Destroy()
                elseif v:IsA("BodyForce") or v:IsA("BodyAngularVelocity") or v:IsA("AngularVelocity")
                    or v:IsA("BodyPosition") or v:IsA("AlignPosition")
                    or v:IsA("BodyGyro") or v:IsA("AlignOrientation") then
                    local n = v.Name:lower()
                    if not (n:find("hdadminfly") or n:find("fly")) then
                        v:Destroy()
                    end
                end
            end
        end
    end
    
    if isAntiMoveEnabled then
        if not frozenCFrame then frozenCFrame = hrp.CFrame end
        hrp.CFrame = frozenCFrame
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    else
        frozenCFrame = nil
    end
    
    if isAntiSitEnabled and hum.Sit then
        hum.Sit = false
    end
    
    -- مضاد القفز
    if isAntiJumpEnabled then
        if not antiJumpApplied then
            if not jumpSettingsSaved then
                originalJumpPower    = hum.JumpPower
                originalJumpHeight   = hum.JumpHeight
                originalUseJumpPower = hum.UseJumpPower
                jumpSettingsSaved    = true
            end
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn then jumpBtn.Visible = false end
            end
            antiJumpApplied = true
        end
    else
        if antiJumpApplied then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            if jumpSettingsSaved then
                hum.JumpPower    = originalJumpPower
                hum.JumpHeight   = originalJumpHeight
                hum.UseJumpPower = originalUseJumpPower
                jumpSettingsSaved = false
            end
            if Player:FindFirstChild("PlayerGui") then
                local jumpBtn = Player.PlayerGui:FindFirstChild("JumpButton", true)
                if jumpBtn then jumpBtn.Visible = true end
            end
            antiJumpApplied = false
        end
    end
    
    if (tick() - lastHitTime) > 0.5 and (tick() - lastThrowTime) > 0.5 then
        if not isAntiMoveEnabled then
            lastCFrame = hrp.CFrame
        end
    end
    
    local isThrowProtected = isAntiThrowEnabled and not isFlying and not isSeated
                            and (tick() - lastThrowTime) < 0.4
    local isHitProtected   = isAntiPunchEnabled and not isFlying and not isSeated
                            and (tick() - lastHitTime) < 0.4
    
    if isThrowProtected then
        hrp.CFrame = lastCFrame
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    elseif isHitProtected then
        hrp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end
    
    local isRecentlyThrown = isAntiThrowEnabled and not isFlying and not isSeated
                            and (tick() - lastThrowTime) < 1.0
    
    if isAntiCuffEnabled and not isResetting and not isRecentlyThrown and not isAntiMoveEnabled then
        local isSittingOnSeat = hum.Sit and hum.SeatPart ~= nil
                                and (hum.SeatPart:IsA("Seat") or hum.SeatPart:IsA("VehicleSeat"))
        local isCuffed = false
        
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("RopeConstraint") then
                local p0 = v.Part0 or v.Attachment0
                if p0 and p0.Parent ~= char and p0:FindFirstChildOfClass("Humanoid") then
                    isCuffed = true
                end
            end
        end
        
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("cuff") or tool.Name:lower():find("كلبش")) then
                isCuffed = true
            end
        end
        
        if not isSittingOnSeat and not isAntiSitEnabled then
            if hrp.Anchored or hum.WalkSpeed <= 2 or hum.PlatformStand then
                isCuffed = true
            end
        end
        
        if isCuffed then
            executeSmartReset()
            return
        end
    end
end)

