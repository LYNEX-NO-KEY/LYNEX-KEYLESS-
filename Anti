    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(btn.Size.X.Scale * 0.95, btn.Size.X.Offset, btn.Size.Y.Scale * 0.95, btn.Size.Y.Offset)}):Play()
