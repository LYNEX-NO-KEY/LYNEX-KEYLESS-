local function updateToggleVisual(data, isOn)
    local bg  = isOn and THEME.successBg or THEME.dangerBg
    local col = isOn and THEME.success   or THEME.danger
    TweenService:Create(data.button, TweenInfo.new(0.18), {BackgroundColor3 = bg}):Play()
    TweenService:Create(data.stroke, TweenInfo.new(0.18), {Color = col}):Play()
    TweenService:Create(data.status, TweenInfo.new(0.18), {TextColor3 = col}):Play()
    data.status.Text = isOn and "✓ مفعل" or "✕ معطل"
end

