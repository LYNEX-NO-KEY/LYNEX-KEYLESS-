-- 3. دالة إنشاء زر الانتقال
-- ==========================================
local function createTP(name, x, y, z, parentFrame)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = ColorCard
    btn.Text = "📍 " .. name
    btn.TextColor3 = ColorText
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = parentFrame
    
    local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 8) corner.Parent = btn
    
    local stroke = Instance.new("UIStroke") 
    stroke.Color = ColorAccent 
    stroke.Thickness = 1 
    stroke.Transparency = 0.7 
    stroke.Parent = btn

    btn.MouseButton1Down:Connect(function() 
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0.96, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play() 
        stroke.Transparency = 0.2 
    end)
    
    btn.MouseButton1Up:Connect(function() 
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = ColorCard}):Play() 
        stroke.Transparency = 0.7
    end)

    btn.MouseButton1Click:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(x, y, z) + Vector3.new(0, 3, 0))
            btn.Text = "✅ تم الانتقال"
            btn.TextColor3 = ColorAccent 
            task.wait(1)
            btn.Text = "📍 " .. name
            btn.TextColor3 = ColorText
        end
    end)
end

