local tabNames = {"المهام", "المتاجر", "البنوك", "الصيد", "الرسم", "أخرى", "خيم"}

local tabButtons = {}
local tabFrames = {}

local function createTabButton(text, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 65, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = (index == 1) and ColorAccent or ColorTextDim
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.LayoutOrder = index
    btn.Parent = TabBar
    
    btn.MouseButton1Click:Connect(function()
        for i, b in ipairs(tabButtons) do
            b.TextColor3 = ColorTextDim
        end
        btn.TextColor3 = ColorAccent
        
        for i, f in ipairs(tabFrames) do
            f.Visible = false
        end
        tabFrames[index].Visible = true
        
        local targetPos = (index - 1) * 65 - 30
        if targetPos < 0 then targetPos = 0 end
        TweenService:Create(TabBar, TweenInfo.new(0.2), {CanvasPosition = Vector2.new(targetPos, 0)}):Play()
    end)
    
    table.insert(tabButtons, btn)
end

