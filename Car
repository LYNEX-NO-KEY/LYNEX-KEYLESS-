-- ============ Helper: createCard ============
local function createCard(parent, opts)
    opts = opts or {}
    local card = Instance.new("TextButton")
    card.Name = opts.name or "Card"
    card.Parent = parent
    card.BackgroundColor3 = C.card
    card.BorderSizePixel = 0
    card.Text = ""
    card.AutoButtonColor = false
    card.Size = opts.size or UDim2.new(1, 0, 0, 32)
    card.Position = opts.position or UDim2.new(0, 0, 0, 0)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = card

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.stroke
    stroke.Thickness = 1
    stroke.Transparency = 0.25
    stroke.Parent = card

    if opts.icon then
        local iconBg = Instance.new("Frame")
        iconBg.Name = "IconBg"
        iconBg.Parent = card
        iconBg.Size = UDim2.new(0, 22, 0, 22)
        iconBg.Position = UDim2.new(0, 6, 0.5, -11)
        iconBg.BackgroundColor3 = C.iconBg
        iconBg.BorderSizePixel = 0

        local ibC = Instance.new("UICorner")
        ibC.CornerRadius = UDim.new(0, 5)
        ibC.Parent = iconBg

        local ibGrad = Instance.new("UIGradient")
        ibGrad.Color = ColorSequence.new(C.iconBg, Color3.fromRGB(40, 32, 68))
        ibGrad.Rotation = 135
        ibGrad.Parent = iconBg

        local img = Instance.new("ImageLabel")
        img.Parent = iconBg
        img.BackgroundTransparency = 1
        img.Size = UDim2.new(0, 14, 0, 14)
        img.Position = UDim2.new(0.5, -7, 0.5, -7)
        img.Image = opts.icon
        img.ImageColor3 = Color3.fromRGB(215, 195, 255)
        img.ScaleType = Enum.ScaleType.Fit
    end

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Parent = card
    label.BackgroundTransparency = 1
    if opts.icon then
        label.Position = UDim2.new(0, 32, 0, 0)
        label.Size = UDim2.new(1, -45, 1, 0)
    else
        label.Position = UDim2.new(0, 8, 0, 0)
        label.Size = UDim2.new(1, -16, 1, 0)
    end
    label.Text = opts.text or ""
    label.TextColor3 = C.text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd

    if opts.isToggle then
        label.Size = UDim2.new(1, (opts.icon and -65 or -35), 1, 0)

        local sw = Instance.new("Frame")
        sw.Name = "Switch"
        sw.Parent = card
        sw.Size = UDim2.new(0, 24, 0, 14)
        sw.Position = UDim2.new(1, -30, 0.5, -7)
        sw.BackgroundColor3 = C.toggleOff
        sw.BorderSizePixel = 0

        local swC = Instance.new("UICorner")
        swC.CornerRadius = UDim.new(1, 0)
        swC.Parent = sw

        local knob = Instance.new("Frame")
        knob.Name = "Knob"
        knob.Parent = sw
        knob.Size = UDim2.new(0, 10, 0, 10)
        knob.Position = UDim2.new(0, 2, 0.5, -5)
        knob.BackgroundColor3 = Color3.fromRGB(220, 218, 235)
        knob.BorderSizePixel = 0

        local kC = Instance.new("UICorner")
        kC.CornerRadius = UDim.new(1, 0)
        kC.Parent = knob
    end

    card.MouseEnter:Connect(function()
        if not card:GetAttribute("Active") then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = C.cardHover}):Play()
        end
    end)
    card.MouseLeave:Connect(function()
        if not card:GetAttribute("Active") then
            TweenService:Create(card, TweenInfo.new(0.15), {BackgroundColor3 = C.card}):Play()
        end
    end)
    card.MouseButton1Down:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.08), {BackgroundColor3 = C.cardHover}):Play()
    end)

    return card
end

-- ============ Helper: setToggleState ============
local function setToggleState(card, active)
    card:SetAttribute("Active", active)
    local sw = card:FindFirstChild("Switch")
    local stroke = card:FindFirstChildWhichIsA("UIStroke")
    local label = card:FindFirstChild("Label")

    if sw then
        local knob = sw:FindFirstChild("Knob")
        TweenService:Create(sw, TweenInfo.new(0.2), {
            BackgroundColor3 = active and C.success or C.toggleOff
        }):Play()
        if knob then
            TweenService:Create(knob, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = active and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
            }):Play()
        end
    end
    if stroke then
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = active and C.strokeActive or C.stroke,
            Transparency = active and 0 or 0.25
        }):Play()
    end
    if label then
        TweenService:Create(label, TweenInfo.new(0.15), {
            TextColor3 = active and C.success or C.text
        }):Play()
    end
    TweenService:Create(card, TweenInfo.new(0.2), {
        BackgroundColor3 = active and C.cardActiveBg or C.card
    }):Play()
end

-- ============ Helper: input row ============
local function createInputRow(parent, labelText, defaultVal, yPos)
    local row = Instance.new("Frame")
    row.Parent = parent
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.Size = UDim2.new(1, 0, 0, 32)
    row.BackgroundColor3 = C.card
    row.BorderSizePixel = 0

    local rC = Instance.new("UICorner")
    rC.CornerRadius = UDim.new(0, 6)
    rC.Parent = row

    local rStroke = Instance.new("UIStroke")
    rStroke.Color = C.stroke
    rStroke.Thickness = 1
    rStroke.Transparency = 0.25
    rStroke.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Parent = row
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Text = labelText
    lbl.TextColor3 = C.text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd

    local inp = Instance.new("TextBox")
    inp.Parent = row
    inp.Position = UDim2.new(1, -52, 0, 4)
    inp.Size = UDim2.new(0, 44, 1, -8)
    inp.BackgroundColor3 = Color3.fromRGB(18, 16, 26)
    inp.BorderSizePixel = 0
    inp.Text = tostring(defaultVal)
    inp.TextColor3 = C.accent2
    inp.Font = Enum.Font.GothamBold
    inp.TextSize = 10
    inp.ClearTextOnFocus = false
    inp.PlaceholderText = tostring(defaultVal)
    inp.PlaceholderColor3 = C.textDim

    local iC = Instance.new("UICorner")
    iC.CornerRadius = UDim.new(0, 5)
    iC.Parent = inp

    local iStroke = Instance.new("UIStroke")
    iStroke.Color = C.stroke
    iStroke.Thickness = 1
    iStroke.Parent = inp

    inp.Focused:Connect(function()
        TweenService:Create(iStroke, TweenInfo.new(0.15), {Color = C.accent2}):Play()
    end)
    inp.FocusLost:Connect(function()
        TweenService:Create(iStroke, TweenInfo.new(0.15), {Color = C.stroke}):Play()
    end)

    return row, inp
end

-- ============ Helper: control row ============
local function createCtrlRow(parent, yPos)
    local row = Instance.new("Frame")
    row.Parent = parent
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.Size = UDim2.new(1, 0, 0, 32)
    row.BackgroundTransparency = 1

    local function ctrlBtn(text, color, xPos)
        local b = Instance.new("TextButton")
        b.Parent = row
        b.Size = UDim2.new(0.25, -2, 1, 0)
        b.Position = UDim2.new(xPos, 2, 0, 0)
        b.BackgroundColor3 = color
        b.BorderSizePixel = 0
        b.Text = text
        b.TextColor3 = C.text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 9
        b.AutoButtonColor = false

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 5)
        c.Parent = b

        local s = Instance.new("UIStroke")
        s.Color = C.stroke
        s.Thickness = 1
        s.Transparency = 0.25
        s.Parent = b

        b.MouseEnter:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.15), {
                BackgroundColor3 = color:Lerp(Color3.fromRGB(255,255,255), 0.12)
            }):Play()
        end)
        b.MouseLeave:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
        end)
        return b
    end

    return row, ctrlBtn
end

