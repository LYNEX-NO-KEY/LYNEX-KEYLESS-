-- ============ Loop ============
LoopBtn.MouseButton1Click:Connect(function()
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if isAirMoveActive then return end
    isAirMoveActive = true
    local startCF = mainPart.CFrame
    local startPos = startCF.Position
    local lookVec = startCF.LookVector
    local forward = Vector3.new(lookVec.X, 0, lookVec.Z)
    if forward.Magnitude < 0.05 then forward = Vector3.new(0, 0, -1) end
    forward = forward.Unit
    local rightVec = startCF.RightVector
    rightVec = Vector3.new(rightVec.X, 0, rightVec.Z)
    if rightVec.Magnitude < 0.05 then rightVec = Vector3.new(1, 0, 0) end
    rightVec = rightVec.Unit
    local up = Vector3.new(0, 1, 0)
    local radius = 15
    local loopDuration = 1.2
    mainPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    mainPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    task.spawn(function()
        local t0 = tick()
        while true do
            if not mainPart or not mainPart.Parent then isAirMoveActive = false return end
            local t = (tick() - t0) / loopDuration
            if t >= 1 then
                mainPart.CFrame = startCF
                break
            end
            local angle = t * math.pi * 2
            local targetPos = startPos + forward * math.sin(angle) * radius + up * (1 - math.cos(angle)) * radius
            local tangent = (forward * math.cos(angle) + up * math.sin(angle)).Unit
            local newUp = rightVec:Cross(tangent).Unit
            mainPart.CFrame = CFrame.fromMatrix(targetPos, rightVec, newUp, -tangent)
            task.wait(0.01)
        end
        isAirMoveActive = false
    end)
end)

-- ============ Slam Dunk ============
SlamDunkBtn.MouseButton1Click:Connect(function()
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if isAirMoveActive then return end
    isAirMoveActive = true
    local riseHeight = 60
    local startCF = mainPart.CFrame
    local startPos = startCF.Position
    local rotPart = startCF - startPos
    task.spawn(function()
        local t0 = tick()
        while true do
            if not mainPart or not mainPart.Parent then isAirMoveActive = false return end
            local t = (tick() - t0) / 0.5
            if t >= 1 then
                mainPart.CFrame = CFrame.new(startPos + Vector3.new(0, riseHeight, 0)) * rotPart
                break
            end
            mainPart.CFrame = CFrame.new(startPos + Vector3.new(0, riseHeight * (1 - (1 - t)^2), 0)) * rotPart
            task.wait(0.01)
        end
        task.wait(0.15)
        if not mainPart or not mainPart.Parent then isAirMoveActive = false return end
        mainPart.AssemblyLinearVelocity = Vector3.new(0, -350, 0)
        task.wait(0.5)
        isAirMoveActive = false
    end)
end)

