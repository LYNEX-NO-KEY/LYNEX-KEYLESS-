    task.spawn(function()
        while true do
            if not mainPart or not mainPart.Parent then isRotating = false return end
            local t = (tick() - t0) / duration
            if t >= 1 then
                mainPart.CFrame = startCF * rotCF
                mainPart.AssemblyLinearVelocity = rotCF * startVel
                break
            end
            local eased = t * t * (3 - 2 * t)
            mainPart.CFrame = startCF * CFrame.Angles(0, math.rad(degrees * eased), 0)
            task.wait(0.01)
        end
        isRotating = false
    end)
end
RotRightBtn.MouseButton1Click:Connect(function() rotateCar(-90) end)
RotLeftBtn.MouseButton1Click:Connect(function() rotateCar(90) end)

-- ========== تثبيت في هواء ==========
local hoverActive = false
local hoverBP = nil
local function stopHover()
    hoverActive = false
    setToggleState(HoverBtn, false)
    if hoverBP then hoverBP:Destroy() hoverBP = nil end
end
HoverBtn.MouseButton1Click:Connect(function()
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if hoverActive then
        stopHover()
    else
        hoverActive = true
        setToggleState(HoverBtn, true)
        hoverBP = Instance.new("BodyPosition")
        hoverBP.MaxForce = Vector3.new(0, 500000, 0)
        hoverBP.P = 15000
        hoverBP.D = 1500
        hoverBP.Position = mainPart.Position
        hoverBP.Parent = mainPart
        local targetY = mainPart.Position.Y
        task.spawn(function()
            while hoverActive and hoverBP and hoverBP.Parent do
                local _, mp = getVehicle()
                if not mp or mp ~= hoverBP.Parent then stopHover() break end
                hoverBP.Position = Vector3.new(mp.Position.X, targetY, mp.Position.Z)
                task.wait(0.05)
            end
        end)
    end
end)
