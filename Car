local isAirMoveActive = false

local function doCustomFlip(duration, liftHeight, rotationFn)
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if isAirMoveActive then return end
    isAirMoveActive = true

    local startCF = mainPart.CFrame
    local startPos = mainPart.Position
    local rotPart = startCF - startPos
    local liftDuration = 0.25

    task.spawn(function()
        -- رفع
        local t0 = tick()
        while true do
            if not mainPart or not mainPart.Parent then isAirMoveActive = false return end
            local t = (tick() - t0) / liftDuration
            if t >= 1 then
                mainPart.CFrame = CFrame.new(startPos + Vector3.new(0, liftHeight, 0)) * rotPart
                break
            end
            local eased = 1 - (1 - t) * (1 - t)
            mainPart.CFrame = CFrame.new(startPos + Vector3.new(0, liftHeight * eased, 0)) * rotPart
            task.wait(0.01)
        end

        -- دوران
        local liftCF = mainPart.CFrame
        local t1 = tick()
        while true do
            if not mainPart or not mainPart.Parent then isAirMoveActive = false return end
            local t = (tick() - t1) / duration
            if t >= 1 then
                mainPart.CFrame = liftCF
                break
            end
            mainPart.CFrame = liftCF * rotationFn(t)
            task.wait(0.01)
        end

        isAirMoveActive = false
    end)
end

