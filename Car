-- ========== اختراق ==========
local noclipActive = false
local modifiedParts = {}
local function restoreNoclip()
    for part, origState in pairs(modifiedParts) do
        if part and part.Parent then part.CanCollide = origState end
    end
    modifiedParts = {}
end
NoclipBtn.MouseButton1Click:Connect(function()
    if noclipActive then
        noclipActive = false
        restoreNoclip()
        setToggleState(NoclipBtn, false)
    else
        local _, mainPart = getVehicle()
        if not mainPart then showWarning("اركب سيارة أولاً!") return end
        noclipActive = true
        setToggleState(NoclipBtn, true)
        task.spawn(function()
            while noclipActive do
                local v, mp = getVehicle()
                if not mp then
                    noclipActive = false
                    restoreNoclip()
                    setToggleState(NoclipBtn, false)
                    break
                end
                for _, part in ipairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if modifiedParts[part] == nil then modifiedParts[part] = part.CanCollide end
                        part.CanCollide = false
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

-- ========== شقلبه في هواء ==========
local isFlipping = false

FlipBtn.MouseButton1Click:Connect(function()
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if isFlipping then return end

    isFlipping = true

    local liftHeight = 12
    local liftDuration = 0.25
    local flipDuration = 0.6

    local liftStartPos = mainPart.Position
    local liftStartCF = mainPart.CFrame
    local liftRotPart = liftStartCF - liftStartCF.Position

    task.spawn(function()
        local liftT0 = tick()
        while true do
            if not mainPart or not mainPart.Parent then isFlipping = false return end
            local t = (tick() - liftT0) / liftDuration
            if t >= 1 then
                mainPart.CFrame = CFrame.new(liftStartPos + Vector3.new(0, liftHeight, 0)) * liftRotPart
                break
            end
            local eased = 1 - (1 - t) * (1 - t)
            mainPart.CFrame = CFrame.new(liftStartPos + Vector3.new(0, liftHeight * eased, 0)) * liftRotPart
            task.wait(0.01)
        end

        local flipStartCF = mainPart.CFrame
        local flipT0 = tick()

        while true do
            if not mainPart or not mainPart.Parent then isFlipping = false return end
            local t = (tick() - flipT0) / flipDuration
            if t >= 1 then
                mainPart.CFrame = flipStartCF
                break
            end
            local angle = math.rad(360) * t
            mainPart.CFrame = flipStartCF * CFrame.Angles(angle, 0, 0)
            task.wait(0.01)
        end

        isFlipping = false
    end)
end)

-- ========== دوران يمين / شمال ==========
local isRotating = false

local function rotateCar(degrees)
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end
    if isRotating then return end

    isRotating = true
    local startCF = mainPart.CFrame
    local startVel = mainPart.AssemblyLinearVelocity
    local duration = 0.15
    local t0 = tick()
    local rotCF = CFrame.Angles(0, math.rad(degrees), 0)

    task.spawn(function()
        while true do
            if not mainPart or not mainPart.Parent then isRotating = false return end
            local t = (tick() - t0) / duration
            if t >= 1 then
                mainPart.CFrame = startCF * rotCF
                local newVel = rotCF * startVel
                mainPart.AssemblyLinearVelocity = newVel
                break
            end
            local eased = t * t * (3 - 2 * t)
            mainPart.CFrame = startCF * CFrame.Angles(0, math.rad(degrees * eased), 0)
            task.wait(0.01)
        end
        isRotating = false
    end)
end

RotRightBtn.MouseButton1Click:Connect(function() rotateCar(-90) end)
RotLeftBtn.MouseButton1Click:Connect(function() rotateCar(90) end)

