                local v = verticalDir * flySpeed * 0.7
                local f = forwardDir * flySpeed
                local l = lateralDir * flySpeed * 0.7
                local rightLook = Vector3.new(-flatLook.Z, 0, flatLook.X)
                flyBV.Velocity = (flatLook * f) + (rightLook * l) + Vector3.new(0, v, 0)
                task.wait(0.03)
            end
        end)
    end
end)

