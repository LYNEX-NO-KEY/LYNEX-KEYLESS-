local function createFeatureButton(name, icon, text, isToggle, parent)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = parent or Content
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Thickness = 1
    stroke.Parent = btn

    if icon then
        local img = Instance.new("ImageLabel")
        img.Parent = btn
        img.BackgroundTransparency = 1
        img.Size = UDim2.new(0, 26, 0, 26)
        img.Position = UDim2.new(0.5, -13, 0, 4)
        img.Image = icon
        img.ImageColor3 = Color3.fromRGB(255, 255, 255)
        img.ScaleType = Enum.ScaleType.Fit
    end

    local lbl = Instance.new("TextLabel")
    lbl.Parent = btn
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.Position = UDim2.new(0, 0, 1, -19)
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 11
    lbl.TextTruncate = Enum.TextTruncate.AtEnd

    if isToggle then
        local ind = Instance.new("Frame")
        ind.Name = "ToggleIndicator"
        ind.Parent = btn
        ind.AnchorPoint = Vector2.new(1, 0)
        ind.Position = UDim2.new(1, -5, 0, 5)
        ind.Size = UDim2.new(0, 9, 0, 9)
        ind.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        ind.BorderSizePixel = 0
        local ic = Instance.new("UICorner")
        ic.CornerRadius = UDim.new(1, 0)
        ic.Parent = ind
    end

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(48, 48, 62)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play()
        end
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(20, 120, 255)}):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(48, 48, 62)}):Play()
        end
    end)

    return btn
end

local function setToggleState(btn, active)
    btn:SetAttribute("Active", active)
    local ind = btn:FindFirstChild("ToggleIndicator")
    local stroke = btn:FindFirstChildWhichIsA("UIStroke")
    if ind then
        TweenService:Create(ind, TweenInfo.new(0.15), {
            BackgroundColor3 = active and Color3.fromRGB(0, 230, 130) or Color3.fromRGB(80, 80, 90)
        }):Play()
    end
    if stroke then
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = active and Color3.fromRGB(0, 230, 130) or Color3.fromRGB(60, 60, 80),
            Thickness = active and 2 or 1
        }):Play()
    end
    TweenService:Create(btn, TweenInfo.new(0.15), {
        BackgroundColor3 = active and Color3.fromRGB(28, 55, 42) or Color3.fromRGB(35, 35, 45)
    }):Play()
end

