local carSpeedActive = false
CarSpeedBtn.MouseButton1Click:Connect(function()
    if carSpeedActive then
        carSpeedActive = false
        setToggleState(CarSpeedBtn, false)
    else
        local _, mainPart = getVehicle()
        if not mainPart then showWarning("اركب سيارة أولاً!") return end
        carSpeedActive = true
        setToggleState(CarSpeedBtn, true)
        task.spawn(function()
            local speedHistory = {}
            while carSpeedActive do
                local _, mp = getVehicle()
                if not mp then
                    carSpeedActive = false
                    setToggleState(CarSpeedBtn, false)
                    break
                end
                local v = mp.AssemblyLinearVelocity
                local h = Vector3.new(v.X, 0, v.Z)
                local speed = h.Magnitude
                table.insert(speedHistory, speed)
                if #speedHistory > 6 then table.remove(speedHistory, 1) end
                if speed > 3 and #speedHistory >= 6 then
                    local oldSpeed = speedHistory[1]
                    local notBraking = speed > oldSpeed * 0.8
                    local belowTarget = speed < carSpeedValue * 0.95
                    if notBraking and belowTarget then
                        local dir = h.Unit
                        local newH = dir * carSpeedValue
                        mp.AssemblyLinearVelocity = Vector3.new(newH.X, v.Y, newH.Z)
                    end
                end
                task.wait(0.05)
            end
        end)
    end
end)

