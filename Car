local flyActive = false
local flyBV = nil
local flyBG = nil

local function stopFly()
    flyActive = false
    verticalDir = 0
    forwardDir = 0
    setToggleState(FlyToggleBtn, false)
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

FlyToggleBtn.MouseButton1Click:Connect(function()
    local _, mainPart = getVehicle()
    if not mainPart then showWarning("اركب سيارة أولاً!") return end

    if flyActive then
        stopFly()
    else
        flyActive = true
        setToggleState(FlyToggleBtn, true)

        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(500000, 500000, 500000)
        flyBG.P = 8000
        flyBG.D = 500
        flyBG.CFrame = mainPart.CFrame
        flyBG.Parent = mainPart

        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(500000, 500000, 500000)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = mainPart

        task.spawn(function()
            while flyActive and flyBV and flyBV.Parent do
                local _, mp = getVehicle()
                if not mp or mp ~= flyBV.Parent then stopFly() break end

                local cam = workspace.CurrentCamera
                local camLook = cam.CFrame.LookVector
                local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
                if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
                flyBG.CFrame = CFrame.lookAt(mp.Position, mp.Position + flatLook)

                local v = verticalDir * flySpeed * 0.7
                local f = forwardDir * flySpeed
                flyBV.Velocity = (flatLook * f) + Vector3.new(0, v, 0)

                task.wait(0.03)
            end
        end)
    end
end)

-- ========== أزرار تحكم ==========
local function bindHold(btn, onDown, onUp)
    btn.MouseButton1Down:Connect(onDown)
    btn.MouseButton1Up:Connect(onUp)
    btn.MouseLeave:Connect(onUp)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then onDown() end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then onUp() end
    end)
end

bindHold(UpBtn,
    function() if flyActive then verticalDir = 1 end end,
    function() if verticalDir == 1 then verticalDir = 0 end end
)
bindHold(DownBtn,
    function() if flyActive then verticalDir = -1 end end,
    function() if verticalDir == -1 then verticalDir = 0 end end
)
bindHold(ForwardBtn,
    function() if flyActive then forwardDir = 1 end end,
    function() if forwardDir == 1 then forwardDir = 0 end end
)
bindHold(BackBtn,
    function() if flyActive then forwardDir = -1 end end,
    function() if forwardDir == -1 then forwardDir = 0 end end
)

-- ========== سرعة سياره ==========
local carSpeedActive = false

CarSpeedBtn.MouseButton1Click:Connect(function()
    if carSpeedActive then
        carSpeedActive = false
        setToggleState(CarSpeedBtn, false)
    else
        local _, mainPart = getVehicle()
        if not mainPart then showWarning("اركب سيارة أولاً!") return end
        carSpeedActive = true
        setToggleState(CarSpeedBtn, true)

        task.spawn(function()
            local speedHistory = {}
            while carSpeedActive do
                local _, mp = getVehicle()
                if not mp then
                    carSpeedActive = false
                    setToggleState(CarSpeedBtn, false)
                    break
                end

                local v = mp.AssemblyLinearVelocity
                local h = Vector3.new(v.X, 0, v.Z)
                local speed = h.Magnitude

                table.insert(speedHistory, speed)
                if #speedHistory > 6 then table.remove(speedHistory, 1) end

                if speed > 3 and #speedHistory >= 6 then
                    local oldSpeed = speedHistory[1]
                    local notBraking = speed > oldSpeed * 0.8
                    local belowTarget = speed < carSpeedValue * 0.95

                    if notBraking and belowTarget then
                        local dir = h.Unit
                        local newH = dir * carSpeedValue
                        mp.AssemblyLinearVelocity = Vector3.new(newH.X, v.Y, newH.Z)
                    end
                end

                task.wait(0.05)
            end
        end)
    end
end)

