local bindKey = Enum.KeyCode.E
local isBinding = false
local lastCuffTime = 0

local function getClosestPlayer()
    local closest, shortest = nil, CUFF_RANGE
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end

task.spawn(function()
    while gui.Parent do
        if highlightEnabled then
            local target = getClosestPlayer()
            if target then
                if activeHlPlayer ~= target or not activeHlObj or not activeHlObj.Parent then
                    clearHighlight()
                    activeHlPlayer = target
                    activeHlObj = Instance.new("Highlight")
                    activeHlObj.FillColor = Color3.fromRGB(255, 40, 40)
                    activeHlObj.OutlineColor = Color3.fromRGB(255, 0, 0)
                    activeHlObj.FillTransparency = 0.4
                    activeHlObj.OutlineTransparency = 0
                    activeHlObj.Parent = target.Character
                end
            else
                clearHighlight()
            end
        end
        task.wait(0.1)
    end
end)

local function executeCuff()
    -- حماية ضد الضغط المزدوج (0.15 ثانية فقط)
    local now = tick()
    if now - lastCuffTime < CUFF_COOLDOWN then return end
    lastCuffTime = now

    local target = getClosestPlayer()
    if not target then
        setStatus("لا يوجد لاعب قريب (10 متر)", T.Danger, T.Danger)
        task.delay(1, function()
            setStatus("جاهز للكلبش", T.SubText, T.Success)
        end)
        return
    end

    -- ⚡⚡ إطلاق فوري أولاً (بدون أي تأخير) ⚡⚡
    local ok = pcall(function()
        local remote = RS.BetweenSides.Remotes.Events.CuffsHandler
        if remote then
            remote:FireServer("TOGGLE_CUFF", target.Character)
        end
    end)

    -- ثم تحديث الحالة (لا يؤثر على السرعة)
    if ok then
        setStatus("✓ تم كلبش " .. target.Name, T.Success, T.Success)
    else
        setStatus("✕ فشل الكلبش", T.Danger, T.Danger)
    end

    task.delay(1.2, function()
        setStatus("جاهز للكلبش", T.SubText, T.Success)
    end)
end

cuffBtn.MouseButton1Click:Connect(function()
    local mx = UserInputService:GetMouseLocation()
    ripple(cuffBtn, mx.X - cuffBtn.AbsolutePosition.X, mx.Y - cuffBtn.AbsolutePosition.Y)
    executeCuff()
end)

keyBtn.MouseButton1Click:Connect(function()
    if isBinding then return end
    isBinding = true
    keyBtn.Text = "..."
    keyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    keyStroke.Color = T.SubText
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if isBinding then
        bindKey = input.KeyCode
        keyBtn.Text = tostring(bindKey.Name)
        keyBtn.BackgroundColor3 = T.Header1
        keyStroke.Color = T.Gold
        isBinding = false
        return
    end

    if input.KeyCode == bindKey then
        ripple(cuffBtn, cuffBtn.AbsoluteSize.X / 2, cuffBtn.AbsoluteSize.Y / 2)
        executeCuff()
    end
end)

