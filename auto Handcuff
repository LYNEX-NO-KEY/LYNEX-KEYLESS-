    if collapsed then
        content.Visible = false
        TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = COLLAPSED}):Play()
        TweenService:Create(shadow, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = COLLAPSED}):Play()
        minBtn.Text = "+"
    else
        TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = EXPANDED}):Play()
        TweenService:Create(shadow, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = EXPANDED}):Play()
        task.wait(0.2)
        content.Visible = true
        minBtn.Text = "-"
    end
end)

