-- ============ ✏️ DRAWING HELPERS ============
local function newText(size, color)
    local t = Drawing.new("Text")
    t.Size, t.Color, t.Center, t.Outline = size, color, true, true
    t.OutlineColor = Color3.new(0,0,0)
    t.Visible = false
    return t
end

local function newLine(color, thickness)
    local l = Drawing.new("Line")
    l.Thickness, l.Color, l.Transparency, l.Visible = thickness or 1.5, color, 1, false
    return l
end

local function newSquare(color, filled, thickness)
    local s = Drawing.new("Square")
    s.Color, s.Filled = color, filled or false
    s.Thickness, s.Transparency, s.Visible = thickness or 1, 1, false
    return s
end

local function hpColor(pct)
    if pct > 0.6 then return T.green
    elseif pct > 0.3 then return T.yellow
    else return T.red end
end

-- ============ 🧑 PLAYER SETUP ============
local function attachHighlight(plr, char)
    if plr == lp or not char then return end
    local obj = esp[plr]; if not obj then return end
    local old = char:FindFirstChild("H_ESP"); if old then old:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "H_ESP"
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor = T.orange
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Enabled = S.highlight and S.master
    hl.Parent = char
    obj.Highlight = hl
end

local function setupPlayer(plr)
    if plr == lp then return end
    local skel = {}
    for i = 1, MAX_BONES do skel[i] = newLine(ESP_COLORS.skeleton, 1.5) end
    esp[plr] = {
        Line = newLine(ESP_COLORS.tracer, 1.2),
        Name = newText(13, ESP_COLORS.name),
        HealthBar = newSquare(Color3.new(0,0,0), true),
        HealthFill = newSquare(T.green, true),
        Dist = newText(11, ESP_COLORS.dist),
        Tool = newText(12, ESP_COLORS.tool),
        Skeleton = skel,
        BoxTopL = newLine(ESP_COLORS.box, 1), BoxTopR = newLine(ESP_COLORS.box, 1),
        BoxBotL = newLine(ESP_COLORS.box, 1), BoxBotR = newLine(ESP_COLORS.box, 1),
        BoxTL = newLine(ESP_COLORS.box, 1.5), BoxTR = newLine(ESP_COLORS.box, 1.5),
        BoxBL = newLine(ESP_COLORS.box, 1.5), BoxBR = newLine(ESP_COLORS.box, 1.5),
        Highlight = nil,
    }
    if plr.Character then attachHighlight(plr, plr.Character) end
    plr.CharacterAdded:Connect(function(c) task.wait(0.3) attachHighlight(plr, c) end)
end

local function removePlayer(plr)
    local obj = esp[plr]; if not obj then return end
    for _, k in ipairs({"Line","Name","HealthBar","HealthFill","Dist","Tool",
        "BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
        pcall(function() obj[k]:Remove() end)
    end
    for _, l in ipairs(obj.Skeleton) do pcall(function() l:Remove() end) end
    if obj.Highlight then obj.Highlight:Destroy() end
    esp[plr] = nil
end

for _, p in pairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- ============ 👻 ITEM ESP ============
local function clearItemEsp()
    for obj, data in pairs(itemEsp) do
        if data.Text then pcall(function() data.Text:Remove() end) end
        if data.Highlight then data.Highlight:Destroy() end
    end
    itemEsp = {}
end

local function scanItems()
    clearItemEsp()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and ITEM_NAMES[obj.Name] then
            local t = newText(12, ESP_COLORS.item)
            local hl = Instance.new("Highlight")
            hl.FillColor = T.purple
            hl.FillTransparency = 0.7
            hl.OutlineColor = T.orange
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = obj
            hl.Enabled = false
            hl.Parent = obj
            itemEsp[obj] = {Text = t, Highlight = hl}
        end
    end
end

-- ============ 🎯 RENDER LOOP ============
RunService.RenderStepped:Connect(function()
    if not S.master then return end
    local lpChar = lp.Character
    local lpRoot = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local screenCenter = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)

    if fovCircle then
        fovCircle.Position = screenCenter
        fovCircle.Visible = S.fov
    end

    for plr, obj in pairs(esp) do
        local skip = false
        if S.teamCheck and plr.Team and lp.Team and plr.Team == lp.Team then
            skip = true
        end

        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if skip or not head or not hrp or not hum or hum.Health <= 0 then
            obj.Line.Visible = false; obj.Name.Visible = false
            obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
            obj.Dist.Visible = false; obj.Tool.Visible = false
            for _, l in ipairs(obj.Skeleton) do l.Visible = false end
            for _, k in ipairs({"BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
                obj[k].Visible = false
            end
            if obj.Highlight then obj.Highlight.Enabled = false end
            continue
        end

        local from = lpRoot and lpRoot.Position or cam.CFrame.Position
        local dist3D = (from - head.Position).Magnitude
        if S.maxDist > 0 and dist3D > S.maxDist then
            obj.Line.Visible = false; obj.Name.Visible = false
            obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
            obj.Dist.Visible = false; obj.Tool.Visible = false
            for _, l in ipairs(obj.Skeleton) do l.Visible = false end
            for _, k in ipairs({"BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
                obj[k].Visible = false
            end
            if obj.Highlight then obj.Highlight.Enabled = false end
            continue
        end

        -- 📐 حساب الإحداثيات بدقة من رأس اللاعب لقدمه (وداعاً لـ GetBoundingBox)
        local topPos = head.Position + Vector3.new(0, 1.2, 0)
        local botPos = hrp.Position - Vector3.new(0, 2.8, 0)

        local sTop, oTop = cam:WorldToViewportPoint(topPos)
        local sBot, oBot = cam:WorldToViewportPoint(botPos)

        if not oTop or not oBot or sTop.Z <= 0 or sBot.Z <= 0 then
            obj.Line.Visible = false; obj.Name.Visible = false
            obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
            obj.Dist.Visible = false; obj.Tool.Visible = false
            for _, l in ipairs(obj.Skeleton) do l.Visible = false end
            for _, k in ipairs({"BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
                obj[k].Visible = false
            end
            if obj.Highlight then obj.Highlight.Enabled = false end
            continue
        end

        -- إحداثيات المربع
        local minY = math.min(sTop.Y, sBot.Y)
        local maxY = math.max(sTop.Y, sBot.Y)
        local centerX = (sTop.X + sBot.X) / 2
        local h = maxY - minY
        local w = h * 0.55 -- عرض المربع يتناسب مع طول اللاعب
        
        local minX = centerX - (w / 2)
        local maxX = centerX + (w / 2)
        local sp = Vector2.new(centerX, sTop.Y)

        -- ❤️ Health Bar (بطول اللاعب بالضبط وثابت معه)
        local pct = hum.Health / math.max(hum.MaxHealth, 1)
        if S.health then
            local barW = math.max(w * 0.1, 3) -- عرض شريط الدم
            local barH = h -- طول شريط الدم يساوي طول اللاعب
            
            local barX = minX - barW - 3 -- يلتصق بيسار المربع
            local barY = minY

            obj.HealthBar.Size = Vector2.new(barW, barH)
            obj.HealthBar.Position = Vector2.new(barX, barY)
            obj.HealthBar.Visible = true

            obj.HealthFill.Size = Vector2.new(barW, barH * pct)
            obj.HealthFill.Position = Vector2.new(barX, barY + barH * (1 - pct))
            obj.HealthFill.Color = hpColor(pct)
            obj.HealthFill.Visible = true
        else
            obj.HealthBar.Visible = false
            obj.HealthFill.Visible = false
        end

        -- 📝 Text Elements (مرتبة فوق المربع مباشرة)
        local eqTool = char:FindFirstChildOfClass("Tool")
        
        obj.Tool.Visible = S.tool and eqTool ~= nil
        if obj.Tool.Visible then
            obj.Tool.Position = Vector2.new(centerX, minY - 42)
            obj.Tool.Text = "["..eqTool.Name.."]"
        end

        obj.Name.Visible = S.name
        if S.name then
            obj.Name.Position = Vector2.new(centerX, minY - 26)
            obj.Name.Text = plr.DisplayName
        end

        obj.Dist.Visible = S.distance
        if S.distance then
            obj.Dist.Position = Vector2.new(centerX, minY - 12)
            obj.Dist.Text = ("%dm"):format(math.floor(dist3D))
        end

        -- 🎯 Tracer
        if S.tracer then
            obj.Line.Visible = true
            obj.Line.From = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y)
            obj.Line.To = sp
        else
            obj.Line.Visible = false
        end

        -- 🦴 Skeleton
        if S.skeleton then
            local bones = char:FindFirstChild("UpperTorso") and BONES_R15 or BONES_R6
            for i, b in ipairs(bones) do
                local p1, p2 = char:FindFirstChild(b[1]), char:FindFirstChild(b[2])
                if p1 and p2 then
                    local s1, o1 = cam:WorldToViewportPoint(p1.Position)
                    local s2, o2 = cam:WorldToViewportPoint(p2.Position)
                    if o1 and o2 then
                        obj.Skeleton[i].From = Vector2.new(s1.X, s1.Y)
                        obj.Skeleton[i].To = Vector2.new(s2.X, s2.Y)
                        obj.Skeleton[i].Visible = true
                    else obj.Skeleton[i].Visible = false end
                else obj.Skeleton[i].Visible = false end
            end
            for i = #bones + 1, MAX_BONES do obj.Skeleton[i].Visible = false end
        else
            for i = 1, MAX_BONES do obj.Skeleton[i].Visible = false end
        end

        -- 🔲 Box ESP (مرسوم على نفس إحداثيات الدم بالضبط)
        if S.box then
            local cs = math.min(w, h) * 0.25
            obj.BoxTL.From = Vector2.new(minX, minY); obj.BoxTL.To = Vector2.new(minX + cs, minY)
            obj.BoxTR.From = Vector2.new(maxX - cs, minY); obj.BoxTR.To = Vector2.new(maxX, minY)
            obj.BoxBL.From = Vector2.new(minX, maxY); obj.BoxBL.To = Vector2.new(minX + cs, maxY)
            obj.BoxBR.From = Vector2.new(maxX - cs, maxY); obj.BoxBR.To = Vector2.new(maxX, maxY)
            local vcs = math.min(w, h) * 0.25
            obj.BoxTopL.From = Vector2.new(minX, minY); obj.BoxTopL.To = Vector2.new(minX, minY + vcs)
            obj.BoxTopR.From = Vector2.new(maxX, minY); obj.BoxTopR.To = Vector2.new(maxX, minY + vcs)
            obj.BoxBotL.From = Vector2.new(minX, maxY - vcs); obj.BoxBotL.To = Vector2.new(minX, maxY)
            obj.BoxBotR.From = Vector2.new(maxX, maxY - vcs); obj.BoxBotR.To = Vector2.new(maxX, maxY)
            for _, k in ipairs({"BoxTL","BoxTR","BoxBL","BoxBR","BoxTopL","BoxTopR","BoxBotL","BoxBotR"}) do
                obj[k].Visible = true
            end
        else
            for _, k in ipairs({"BoxTL","BoxTR","BoxBL","BoxBR","BoxTopL","BoxTopR","BoxBotL","BoxBotR"}) do
                obj[k].Visible = false
            end
        end

        if obj.Highlight then obj.Highlight.Enabled = S.highlight end
    end

    -- Item ESP Render
    if S.itemEsp then
        for part, data in pairs(itemEsp) do
            if part and part.Parent then
                local s, o = cam:WorldToViewportPoint(part.Position)
                if o and s.Z > 0 then
                    data.Text.Position = Vector2.new(s.X, s.Y)
                    data.Text.Text = part.Name
                    data.Text.Visible = true
                    data.Highlight.Enabled = true
                else
                    data.Text.Visible = false
                    data.Highlight.Enabled = false
                end
            else
                if data.Text then data.Text:Remove() end
                if data.Highlight then data.Highlight:Destroy() end
                itemEsp[part] = nil
            end
        end
    else
        for _, data in pairs(itemEsp) do
            if data.Text then data.Text.Visible = false end
            if data.Highlight then data.Highlight.Enabled = false end
        end
    end
end)

