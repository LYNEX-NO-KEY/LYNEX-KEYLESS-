local function makeToggle(parent, labelText, key, pos, colorOn)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -3, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = S[key] and (colorOn or T.purpleD) or T.bg2
    btn.BorderSizePixel = 0
    btn.Text = labelText .. (S[key] and " ✓" or " ✗")
    btn.TextColor3 = T.text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        btn.Text = labelText .. (S[key] and " ✓" or " ✗")
        btn.BackgroundColor3 = S[key] and (colorOn or T.purpleD) or T.bg2
        if key == "itemEsp" and S.itemEsp then scanItems() end
    end)
    return btn
end

