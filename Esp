local function makeSlider(parent, labelText, yPos, min, max, initial, onChange)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 46)
    container.Position = UDim2.new(0, 0, 0, yPos)
    container.BackgroundColor3 = T.bg2
    container.BorderSizePixel = 0
    container.ZIndex = 12
    container.Parent = parent
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12, 0, 18)
    lbl.Position = UDim2.new(0, 6, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText .. ": " .. (initial == 0 and "∞" or (initial .. "م"))
    lbl.TextColor3 = T.text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Right
    lbl.ZIndex = 12
    lbl.Parent = container

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -12, 0, 4)
    track.Position = UDim2.new(0, 6, 0, 30)
    track.BackgroundColor3 = T.bg3
    track.BorderSizePixel = 0
    track.ZIndex = 12
    track.Parent = container
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = T.orange
    fill.BorderSizePixel = 0
    fill.ZIndex = 13
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 2)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(0, -6, 0.5, -6)
    knob.BackgroundColor3 = T.text
    knob.BorderSizePixel = 0
    knob.ZIndex = 14
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function updateFromX(mouseX)
        local absPos = track.AbsolutePosition.X
        local absSize = track.AbsoluteSize.X
        local pct = math.clamp((mouseX - absPos) / absSize, 0, 1)
        local value = math.floor(min + (max - min) * pct)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -6, 0.5, -6)
        lbl.Text = labelText .. ": " .. (value == 0 and "∞" or (value .. "م"))
        onChange(value)
    end

    local dragBtn = Instance.new("TextButton")
    dragBtn.Size = UDim2.new(1, 20, 0, 24)
    dragBtn.Position = UDim2.new(0, -10, 0, 18)
    dragBtn.BackgroundTransparency = 1
    dragBtn.Text = ""
    dragBtn.ZIndex = 15
    dragBtn.Parent = container

    dragBtn.MouseButton1Down:Connect(function()
        dragging = true
        updateFromX(UIS:GetMouseLocation().X)
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local initPct = (initial - min) / (max - min)
    fill.Size = UDim2.new(initPct, 0, 1, 0)
    knob.Position = UDim2.new(initPct, -6, 0.5, -6)
end

