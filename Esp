-- ============ ✏️ مساعدات الرسم ============
local function newText(size, color)
    local t = Drawing.new("Text")
    t.Size, t.Color, t.Center, t.Outline = size, color, true, true
    t.OutlineColor = Color3.new(0,0,0); t.Visible = false
    return t
end
local function newLine(color, thickness)
    local l = Drawing.new("Line")
    l.Thickness, l.Color, l.Transparency, l.Visible = thickness or 1.5, color, 1, false
    return l
end
local function newSquare(color, filled, thickness)
    local s = Drawing.new("Square")
    s.Color, s.Filled = color, filled or false
    s.Thickness, s.Transparency, s.Visible = thickness or 1, 1, false
    return s
end
local function hpColor(pct)
    if pct > 0.6 then return T.green
    elseif pct > 0.3 then return T.yellow
    else return T.red end
end

local function hideESP(obj)
    if not obj then return end
    obj.Line.Visible = false; obj.Name.Visible = false
    obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
    obj.Dist.Visible = false; obj.Tool.Visible = false
    for _, l in ipairs(obj.Skeleton) do l.Visible = false end
    for _, k in ipairs({"BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
        obj[k].Visible = false
    end
    if obj.Highlight then pcall(function() obj.Highlight.Enabled = false end) end
end

-- ============ 🧑 إعداد اللاعبين ============
local function attachHighlight(plr, char)
    if plr == lp or not char then return end
    local obj = esp[plr]; if not obj then return end
    local old = char:FindFirstChild("H_ESP"); if old then old:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "H_ESP"; hl.FillTransparency = 1; hl.OutlineTransparency = 0
    hl.OutlineColor = T.orange; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char; hl.Enabled = S.highlight and S.master; hl.Parent = char
    obj.Highlight = hl
end

local function setupPlayer(plr)
    if plr == lp then return end
    local skel = {}
    for i = 1, MAX_BONES do skel[i] = newLine(ESP_COLORS.skeleton, 1.5) end
    esp[plr] = {
        Line = newLine(ESP_COLORS.tracer, 1.2),
        Name = newText(13, ESP_COLORS.name),
        HealthBar = newSquare(Color3.new(0,0,0), true),
        HealthFill = newSquare(T.green, true),
        Dist = newText(11, ESP_COLORS.dist),
        Tool = newText(12, ESP_COLORS.tool),
        Skeleton = skel,
        BoxTopL = newLine(ESP_COLORS.box, 1), BoxTopR = newLine(ESP_COLORS.box, 1),
        BoxBotL = newLine(ESP_COLORS.box, 1), BoxBotR = newLine(ESP_COLORS.box, 1),
        BoxTL = newLine(ESP_COLORS.box, 1.5), BoxTR = newLine(ESP_COLORS.box, 1.5),
        BoxBL = newLine(ESP_COLORS.box, 1.5), BoxBR = newLine(ESP_COLORS.box, 1.5),
        Highlight = nil,
    }
    if plr.Character then attachHighlight(plr, plr.Character) end
    plr.CharacterAdded:Connect(function(c) task.wait(0.3) attachHighlight(plr, c) end)
end

local function removePlayer(plr)
    local obj = esp[plr]; if not obj then return end
    for _, k in ipairs({"Line","Name","HealthBar","HealthFill","Dist","Tool",
        "BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
        pcall(function() obj[k]:Remove() end)
    end
    for _, l in ipairs(obj.Skeleton) do pcall(function() l:Remove() end) end
    if obj.Highlight then obj.Highlight:Destroy() end
    esp[plr] = nil
end

for _, p in pairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(removePlayer)

-- ============ 👻 ESP العناصر ============
local function clearItemEsp()
    for obj, data in pairs(itemEsp) do
        if data.Text then pcall(function() data.Text:Remove() end) end
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
    end
    itemEsp = {}
end

local function scanItems()
    clearItemEsp()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and ITEM_NAMES[obj.Name] then
            local t = newText(12, ESP_COLORS.item)
            local hl = Instance.new("Highlight")
            hl.FillColor = T.purple; hl.FillTransparency = 0.7
            hl.OutlineColor = T.orange; hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = obj; hl.Enabled = false; hl.Parent = obj
            itemEsp[obj] = {Text = t, Highlight = hl}
        end
    end
end

