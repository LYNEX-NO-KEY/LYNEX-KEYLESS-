local allTabs = {playerTab, visualTab, extraTab}
local allTabBtns = {tabPlayer, tabVisual, tabExtra}
local function selectTab(i)
    for j, c in ipairs(allTabs) do c.Visible = (i == j) end
    for j, b in ipairs(allTabBtns) do
        b.BackgroundColor3 = (i == j) and T.orangeD or T.bg2
        b.TextColor3 = (i == j) and T.text or T.textDim
    end
end
tabPlayer.MouseButton1Click:Connect(function() selectTab(1) end)
tabVisual.MouseButton1Click:Connect(function() selectTab(2) end)
tabExtra.MouseButton1Click:Connect(function() selectTab(3) end)
selectTab(1)

masterBtn.MouseButton1Click:Connect(function()
    S.master = not S.master
    if S.master then
        masterBtn.Text = "🎃 ESP: ON"
        masterBtn.BackgroundColor3 = T.orange
    else
        masterBtn.Text = "🎃 ESP: OFF"
        masterBtn.BackgroundColor3 = T.orangeD
        for _, obj in pairs(esp) do
            obj.Line.Visible = false; obj.Name.Visible = false
            obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
            obj.Dist.Visible = false; obj.Tool.Visible = false
            for _, l in ipairs(obj.Skeleton) do l.Visible = false end
            for _, k in ipairs({"BoxTopL","BoxTopR","BoxBotL","BoxBotR","BoxTL","BoxTR","BoxBL","BoxBR"}) do
                obj[k].Visible = false
            end
            if obj.Highlight then obj.Highlight.Enabled = false end
        end
        if fovCircle then fovCircle.Visible = false end
    end
end)

local minimized = false
local expandedH, collapsedH = 320, 36
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        TweenService:Create(main, TweenInfo.new(0.25), {Size = UDim2.new(0, 240, 0, collapsedH)}):Play()
        masterBtn.Visible = false; tabBar.Visible = false; contentC.Visible = false
        minBtn.Text = "🎃"
    else
        TweenService:Create(main, TweenInfo.new(0.25), {Size = UDim2.new(0, 240, 0, expandedH)}):Play()
        task.wait(0.05)
        masterBtn.Visible = true; tabBar.Visible = true; contentC.Visible = true
        minBtn.Text = "—"
    end
end)

local dragging, dragStart, startPos
titleLbl.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                  startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        masterBtn.MouseButton1Click:Fire()
    end
end)

