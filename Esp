-- ============ 🎯 حلقة الرسم ============
RunService.RenderStepped:Connect(function()
    if not S.master then return end
    local vps = cam.ViewportSize
    local vpHalf = Vector2.new(vps.X/2, vps.Y/2)
    local lpChar = lp.Character
    local lpRoot = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local fromPos = lpRoot and lpRoot.Position or cam.CFrame.Position

    if fovCircle then
        fovCircle.Position = vpHalf
        fovCircle.Visible = S.fov
    end

    for plr, obj in pairs(esp) do
        local skip = false
        if S.teamCheck and plr.Team ~= nil and lp.Team ~= nil and plr.Team == lp.Team then skip = true end
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if skip or not head or not hrp or not hum or hum.Health <= 0 then hideESP(obj); continue end
        local dist3D = (fromPos - head.Position).Magnitude
        if S.maxDist > 0 and dist3D > S.maxDist then hideESP(obj); continue end

        local topPos = head.Position + Vector3.new(0, 1.2, 0)
        local botPos = hrp.Position - Vector3.new(0, 2.8, 0)
        local sTop, oTop = cam:WorldToViewportPoint(topPos)
        local sBot, oBot = cam:WorldToViewportPoint(botPos)
        if not oTop or not oBot or sTop.Z <= 0 or sBot.Z <= 0 then hideESP(obj); continue end

        local minY = math.min(sTop.Y, sBot.Y)
        local maxY = math.max(sTop.Y, sBot.Y)
        local centerX = (sTop.X + sBot.X) / 2
        local h = math.clamp(maxY - minY, 15, 350)
        local w = h * 0.55
        local minX = centerX - (w / 2)
        local maxX = centerX + (w / 2)
        local sp = Vector2.new(centerX, sTop.Y)

        local pct = hum.Health / math.max(hum.MaxHealth, 1)
        if S.health then
            local barW = math.max(w * 0.1, 3)
            local barH = h
            local barX = minX - barW - 3
            local barY = minY
            obj.HealthBar.Size = Vector2.new(barW, barH)
            obj.HealthBar.Position = Vector2.new(barX, barY)
            obj.HealthBar.Visible = true
            obj.HealthFill.Size = Vector2.new(barW, barH * pct)
            obj.HealthFill.Position = Vector2.new(barX, barY + barH * (1 - pct))
            obj.HealthFill.Color = hpColor(pct)
            obj.HealthFill.Visible = true
        else
            obj.HealthBar.Visible = false; obj.HealthFill.Visible = false
        end

        local eqTool = char:FindFirstChildOfClass("Tool")
        obj.Tool.Visible = S.tool and eqTool ~= nil
        if obj.Tool.Visible then
            obj.Tool.Position = Vector2.new(centerX, minY - 42)
            obj.Tool.Text = "["..eqTool.Name.."]"
        end
        obj.Name.Visible = S.name
        if S.name then
            obj.Name.Position = Vector2.new(centerX, minY - 26)
            obj.Name.Text = plr.DisplayName
        end
        obj.Dist.Visible = S.distance
        if S.distance then
            obj.Dist.Position = Vector2.new(centerX, minY - 12)
            obj.Dist.Text = ("%dm"):format(math.floor(dist3D))
        end

        if S.tracer then
            obj.Line.Visible = true
            obj.Line.From = Vector2.new(vps.X/2, vps.Y)
            obj.Line.To = sp
        else obj.Line.Visible = false end

        if S.skeleton then
            local bones = char:FindFirstChild("UpperTorso") and BONES_R15 or BONES_R6
            for i, b in ipairs(bones) do
                local p1, p2 = char:FindFirstChild(b[1]), char:FindFirstChild(b[2])
                if p1 and p2 then
                    local s1, o1 = cam:WorldToViewportPoint(p1.Position)
                    local s2, o2 = cam:WorldToViewportPoint(p2.Position)
                    if o1 and o2 then
                        obj.Skeleton[i].From = Vector2.new(s1.X, s1.Y)
                        obj.Skeleton[i].To = Vector2.new(s2.X, s2.Y)
                        obj.Skeleton[i].Visible = true
                    else obj.Skeleton[i].Visible = false end
                else obj.Skeleton[i].Visible = false end
            end
            for i = #bones + 1, MAX_BONES do obj.Skeleton[i].Visible = false end
        else
            for i = 1, MAX_BONES do obj.Skeleton[i].Visible = false end
        end

        if S.box then
            local cs = math.min(w, h) * 0.25
            obj.BoxTL.From = Vector2.new(minX, minY); obj.BoxTL.To = Vector2.new(minX + cs, minY)
            obj.BoxTR.From = Vector2.new(maxX - cs, minY); obj.BoxTR.To = Vector2.new(maxX, minY)
            obj.BoxBL.From = Vector2.new(minX, maxY); obj.BoxBL.To = Vector2.new(minX + cs, maxY)
            obj.BoxBR.From = Vector2.new(maxX - cs, maxY); obj.BoxBR.To = Vector2.new(maxX, maxY)
            local vcs = math.min(w, h) * 0.25
            obj.BoxTopL.From = Vector2.new(minX, minY); obj.BoxTopL.To = Vector2.new(minX, minY + vcs)
            obj.BoxTopR.From = Vector2.new(maxX, minY); obj.BoxTopR.To = Vector2.new(maxX, minY + vcs)
            obj.BoxBotL.From = Vector2.new(minX, maxY - vcs); obj.BoxBotL.To = Vector2.new(minX, maxY)
            obj.BoxBotR.From = Vector2.new(maxX, maxY - vcs); obj.BoxBotR.To = Vector2.new(maxX, maxY)
            for _, k in ipairs({"BoxTL","BoxTR","BoxBL","BoxBR","BoxTopL","BoxTopR","BoxBotL","BoxBotR"}) do
                obj[k].Visible = true
            end
        else
            for _, k in ipairs({"BoxTL","BoxTR","BoxBL","BoxBR","BoxTopL","BoxTopR","BoxBotL","BoxBotR"}) do
                obj[k].Visible = false
            end
        end
        if obj.Highlight then obj.Highlight.Enabled = S.highlight end
    end

    if S.itemEsp then
        for part, data in pairs(itemEsp) do
            if part and part.Parent then
                local s, o = cam:WorldToViewportPoint(part.Position)
                if o and s.Z > 0 then
                    data.Text.Position = Vector2.new(s.X, s.Y)
                    data.Text.Text = part.Name
                    data.Text.Visible = true
                    data.Highlight.Enabled = true
                else
                    data.Text.Visible = false; data.Highlight.Enabled = false
                end
            else
                if data.Text then data.Text:Remove() end
                if data.Highlight then data.Highlight:Destroy() end
                itemEsp[part] = nil
            end
        end
    else
        for _, data in pairs(itemEsp) do
            if data.Text then data.Text.Visible = false end
            if data.Highlight then data.Highlight.Enabled = false end
        end
    end
end)

