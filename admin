end

local function applyHighlight(plr)
    if not plr.Character or activeHighlights[plr] then return end
    local h = Instance.new("Highlight")
    h.Adornee = plr.Character
    h.FillColor = ColorRed
    h.OutlineColor = ColorAccent
    h.FillTransparency = 0.5
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = CoreGui
    activeHighlights[plr] = h
end

local function removeHighlight(plr)
    if activeHighlights[plr] then activeHighlights[plr]:Destroy() activeHighlights[plr] = nil end
end

local function applyText(plr)
    if not plr.Character or activeBillboards[plr] then return end
    local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
    if not head then return end
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 120, 0, 30)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = CoreGui
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = "👑 ادمن 👑"
    t.TextColor3 = ColorAccent
    t.TextStrokeTransparency = 0
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.Parent = bb
    activeBillboards[plr] = bb
end

local function removeText(plr)
    if activeBillboards[plr] then activeBillboards[plr]:Destroy() activeBillboards[plr] = nil end
end

local function applyLine(plr)
    if not plr.Character or activeLines[plr] then return end
    if Drawing then
        local l = Drawing.new("Line")
        l.Visible = false
        l.Thickness = 2
        l.Color = ColorAccent
        l.Transparency = 0.6
        activeLines[plr] = l
    end
end

local function removeLine(plr)
    if activeLines[plr] then activeLines[plr]:Remove() activeLines[plr] = nil end
end

RunService.RenderStepped:Connect(function()
    if not isLineActive then return end
    local ss = camera.ViewportSize
    local startPos = Vector2.new(ss.X / 2, ss.Y)
    for plr, line in pairs(activeLines) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local sp, onS = camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
            if onS then
                line.From = startPos
                line.To = Vector2.new(sp.X, sp.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end)

local pulseConn = nil
local function startPulse()
    if pulseConn then return end
    pulseConn = RunService.Heartbeat:Connect(function()
        local a = (math.sin(tick() * 3) + 1) / 2
        local tr = 0.25 + a * 0.45
        for _, h in pairs(activeHighlights) do
            if h and h.Parent then h.FillTransparency = tr end
        end
    end)
end

local function stopPulse()
    if pulseConn then pulseConn:Disconnect() pulseConn = nil end
    for _, h in pairs(activeHighlights) do
        if h and h.Parent then h.FillTransparency = 0.5 end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        local myPos
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            myPos = player.Character.HumanoidRootPart.Position
        end
        for plr, lbl in pairs(cardDistanceLabels) do
            if lbl and lbl.Parent then
                if myPos and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local d = math.floor((plr.Character.HumanoidRootPart.Position - myPos).Magnitude)
                    lbl.Text = d .. "m"
                else
                    lbl.Text = "—"
                end
            end
        end
    end
end)

local function scanLoop()
    while task.wait(1.5) do
        local currentAdmins = {}

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and hasAdminHandcuffs(plr) then
                currentAdmins[plr] = true
            end
        end

        local srvAdmins = fetchServerAdmins()
        if type(srvAdmins) == "table" then
            for _, aName in pairs(srvAdmins) do
                local t = Players:FindFirstChild(tostring(aName))
                if t then currentAdmins[t] = true end
            end
        end

        for plr in pairs(currentAdmins) do
            local isNew = not detectedAdmins[plr]
            detectedAdmins[plr] = true
            createAdminCard(plr)

            if trackedCharacters[plr] ~= plr.Character then
                trackedCharacters[plr] = plr.Character
                removeHighlight(plr) removeText(plr) removeLine(plr)
            end

            if isNew then
                local n = plr.DisplayName or plr.Name or "أدمن"
                showNotification("👑", "أدمن جديد", n .. " دخل الكشف", ColorAccent)
            end

            if isHighlightActive then applyHighlight(plr) end
            if isTextActive then applyText(plr) end
            if isLineActive then applyLine(plr) end
        end

        for plr in pairs(detectedAdmins) do
            if not currentAdmins[plr] then
                local alive = plr.Parent ~= nil and plr.Character
                    and plr.Character:FindFirstChild("Humanoid")
                    and plr.Character.Humanoid.Health > 0
                if alive then
                    local n = plr.DisplayName or plr.Name or "أدمن"
                    detectedAdmins[plr] = nil
                    trackedCharacters[plr] = nil
                    removeAdminCard(plr) removeHighlight(plr) removeText(plr) removeLine(plr)
                    showNotification("🚪", "خرج من الكشف", n .. " لم يعد أدمن", ColorRed)
                end
            end
        end

        local count = 0
        for _ in pairs(detectedAdmins) do count = count + 1 end
        CountLabel.Text = tostring(count)

        ListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    end
end
task.spawn(scanLoop)

