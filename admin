    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 38, 0, 22)
    track.Position = UDim2.new(1, -48, 0.5, -11)
    track.BackgroundColor3 = ColorBtnOff
    track.BorderSizePixel = 0
    track.Parent = container
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = ColorTextDim
    knob.BorderSizePixel = 0
    knob.Parent = track
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local clickBtn = Instance.new("TextButton")
    clickBtn.Size = UDim2.new(1, 0, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    clickBtn.Parent = container

    local toggle = {container = container, state = false}

    function toggle.setState(on)
        toggle.state = on
        if on then
            TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = ColorAccent}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -20, 0.5, -9), BackgroundColor3 = ColorText}):Play()
            TweenService:Create(cStroke, TweenInfo.new(0.2), {Color = ColorAccent, Transparency = 0.3}):Play()
        else
            TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = ColorBtnOff}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = ColorTextDim}):Play()
            TweenService:Create(cStroke, TweenInfo.new(0.2), {Color = ColorBorder, Transparency = 0.5}):Play()
        end
    end

    clickBtn.MouseEnter:Connect(function()
        TweenService:Create(container, TweenInfo.new(0.15), {BackgroundColor3 = ColorCardHover}):Play()
    end)
    clickBtn.MouseLeave:Connect(function()
        TweenService:Create(container, TweenInfo.new(0.15), {BackgroundColor3 = ColorCard}):Play()
    end)

    return toggle, clickBtn
end

