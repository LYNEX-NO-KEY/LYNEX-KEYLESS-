RunService.RenderStepped:Connect(function()
    if not isLineActive then return end
    local screenSize = camera.ViewportSize
    local startPos = Vector2.new(screenSize.X / 2, screenSize.Y)
    for plr, line in pairs(activeLines) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local screenPos, onScreen = camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
            if onScreen then
                line.From = startPos
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end)

local function scanLoop()
    while task.wait(1.5) do 
        local currentAdmins = {}
        
        -- 1. فحص الكلبشة الحقيقية
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and hasAdminHandcuffs(plr) then
                currentAdmins[plr] = true
            end
        end
        
        -- 2. جلب الأدمن من السيرفر (الرموت)
        local serverAdmins = fetchServerAdmins()
        if type(serverAdmins) == "table" then
            for _, adminName in pairs(serverAdmins) do
                local targetPlr = Players:FindFirstChild(tostring(adminName))
                if targetPlr then
                    currentAdmins[targetPlr] = true
                end
            end
        end
        
        -- 3. تطبيق التحديدات
        for plr in pairs(currentAdmins) do
            detectedAdmins[plr] = true
            createAdminCard(plr)
            if isHighlightActive then applyHighlight(plr) end
            if isTextActive then applyText(plr) end
            if isLineActive then applyLine(plr) end
        end
        
        -- 4. تنظيف اللي خرجوا
        for plr in pairs(detectedAdmins) do
            if not currentAdmins[plr] then
                detectedAdmins[plr] = nil
                removeAdminCard(plr)
                removeHighlight(plr)
                removeText(plr)
                removeLine(plr)
            end
        end
        
        ListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    end
end
task.spawn(scanLoop)

