local function hasAdminHandcuffs(plr)
    local backpack = plr:FindFirstChild("Backpack")
    local char = plr.Character
    local function check(container)
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                local name = string.lower(tool.Name)
                if string.find(name, "admin") and string.find(name, "handcuff") then return true end
                if string.find(tool.Name, "ادارة") and string.find(tool.Name, "كلبش") then return true end
            end
        end
        return false
    end
    return check(backpack) or check(char)
end

local function fetchServerAdmins()
    local betweenSides = ReplicatedStorage:FindFirstChild("BetweenSides")
    if betweenSides and betweenSides:FindFirstChild("Remotes") and betweenSides.Remotes:FindFirstChild("Functions") then
        local getAdmin = betweenSides.Remotes.Functions:FindFirstChild("GetAdminPlayers")
        if getAdmin then
            local success, result = pcall(function() return getAdmin:InvokeServer() end)
            if success and result and type(result) == "table" then
                return result
            end
        end
    end
    return {}
end

