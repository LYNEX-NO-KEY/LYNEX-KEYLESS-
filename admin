local function refreshNotifs(skipIndex)
    for i, card in ipairs(notifCards) do
        if card and card.Parent then
            local fb = #notifCards - i + 1
            local targetY = -fb * 64
            if i == skipIndex then
                TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Position = UDim2.new(0, 0, 1, targetY)}):Play()
            else
                TweenService:Create(card, TweenInfo.new(0.3), {Position = UDim2.new(0, 0, 1, targetY)}):Play()
            end
        end
    end
end

