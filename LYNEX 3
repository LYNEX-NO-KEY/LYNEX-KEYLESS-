-- منطق مضاد الموت + مضاد التجميد + مضاد مكافحة الغش
task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            -- مضاد الموت
            if Toggles.AntiDeath and Toggles.AntiDeath.Value and hum then
                if hum.Health <= 0 then
                    hum.Health = hum.MaxHealth
                end
            end
            
            -- مضاد التجميد
            if Toggles.AntiFreeze and Toggles.AntiFreeze.Value and hum then
                if hum.WalkSpeed == 0 or hum.JumpPower == 0 then
                    hum.WalkSpeed = 16
                    hum.JumpPower = 50
                end
            end
            
            -- مضاد مكافحة الغش
            if Toggles.AntiCheatBypass and Toggles.AntiCheatBypass.Value and hum then
                if hum.WalkSpeed > 500 then hum.WalkSpeed = 16 end
                if hum.JumpPower > 500 then hum.JumpPower = 50 end
                if hum.Gravity ~= 196 then hum.Gravity = 196 end
            end
        end
    end
end)

