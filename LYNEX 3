-- اختراق الجدران
Toggles.Noclip = SpecialGroup:AddToggle("Noclip", {
    Text = "اختراق الجدران",
    Default = false,
})

local noclipConnection
Toggles.Noclip:OnChanged(function(state)
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
        Library:Notify("تم تفعيل اختراق الجدران", 3)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        Library:Notify("تم إيقاف اختراق الجدران", 3)
    end
end)

-- زر الاختفاء
Toggles.Invisible = SpecialGroup:AddToggle("Invisible", {
    Text = "اختفاء (Invisible)",
    Default = false,
    Callback = function(state)
        local char = LocalPlayer.Character
        if not char then return end
        
        if state then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 1
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = 1
                end
            end
            Library:Notify("تم تفعيل الاختفاء", 3)
        else
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 0
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = 0
                end
            end
            Library:Notify("تم إيقاف الاختفاء", 3)
        end
    end
})

-- الطيران
Toggles.Fly = SpecialGroup:AddToggle("Fly", {
    Text = "وضع الطيران (جوال + كمبيوتر)",
    Default = false,
})

local flyConnection
local flyBodyGyro
local flyBodyVelocity

local function StopFly()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = GetHumanoid(LocalPlayer)

        if root then
            if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
            if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
        end

        if hum then
            hum.PlatformStand = false
        end
    end

    Library:Notify("تم إيقاف الطيران", 3)
end

local function StartFly()
    local char = LocalPlayer.Character
    if not char then
        Library:Notify("لا يوجد شخصية", 3)
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = GetHumanoid(LocalPlayer)
    if not root or not hum then
        Library:Notify("لا يمكن بدء الطيران", 3)
        return
    end

    hum.PlatformStand = true

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.P = 9e4
    flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.CFrame = root.CFrame
    flyBodyGyro.Parent = root

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVelocity.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        local hum2 = GetHumanoid(LocalPlayer)
        local root2 = GetRoot(LocalPlayer)
        if not hum2 or not root2 then return end

        local speed = Options.FlightSpeed.Value
        local verticalSpeed = Options.FlightVerticalSpeed.Value

        local camera = workspace.CurrentCamera
        local moveDirection = hum2.MoveDirection

        local velocity = Vector3.new(0, 0, 0)

        if moveDirection.Magnitude > 0 then
            local cameraCF = camera.CFrame
            local forward = cameraCF.LookVector
            local right = cameraCF.RightVector

            forward = Vector3.new(forward.X, 0, forward.Z).Unit
            right = Vector3.new(right.X, 0, right.Z).Unit

            local worldMove = (forward * moveDirection.Z + right * moveDirection.X).Unit
            velocity = worldMove * speed
        end

        local cameraLook = camera.CFrame.LookVector
        local verticalInput = cameraLook.Y

        if math.abs(verticalInput) > 0.1 then
            velocity = velocity + Vector3.new(0, verticalInput * verticalSpeed, 0)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            velocity = velocity + Vector3.new(0, verticalSpeed, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            velocity = velocity - Vector3.new(0, verticalSpeed, 0)
        end

        flyBodyVelocity.Velocity = velocity
        flyBodyGyro.CFrame = CFrame.new(root2.Position, root2.Position + cameraLook)
    end)

    Library:Notify("تم تفعيل الطيران - استخدم الجويستيك للحركة", 4)
end

Toggles.Fly:OnChanged(function(state)
    if state then
        StartFly()
    else
        StopFly()
    end
end)

