-- 5. منطق أزرار الكاش والستريك
cashBtn.MouseButton1Click:Connect(function()
    cashEnabled = not cashEnabled
    if cashEnabled then
        cashBtn.TextColor3 = blueFireColor
        cashStroke.Color = blueFireColor
        cashBtn.BackgroundColor3 = Color3.fromRGB(0, 50, 100)
    else
        cashBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        cashStroke.Color = Color3.fromRGB(100, 100, 100)
        cashBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
        for obj, origText in pairs(originalCashData) do
            if obj and obj.Parent then obj.Text = origText end
        end
        originalCashData = {}
    end
end)

streakBtn.MouseButton1Click:Connect(function()
    streakEnabled = not streakEnabled
    if streakEnabled then
        streakBtn.TextColor3 = blueFireColor
        streakStroke.Color = blueFireColor
        streakBtn.BackgroundColor3 = Color3.fromRGB(0, 50, 100)
    else
        streakBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        streakStroke.Color = Color3.fromRGB(100, 100, 100)
        streakBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            if root:FindFirstChild("Tag") and root.Tag:FindFirstChild("uiTag") and root.Tag.uiTag:FindFirstChild("User") then
                local sreakFrame = root.Tag.uiTag.User:FindFirstChild("SreakFrame")
                if sreakFrame then
                    local num = sreakFrame:FindFirstChild("Num")
                    if num and num:IsA("TextLabel") and originalStreakText then
                        num.Text = originalStreakText
                        num.TextColor3 = originalStreakColor
                    end
                    for _, child in pairs(sreakFrame:GetDescendants()) do
                        if child:IsA("ImageLabel") and originalFireColor then
                            child.ImageColor3 = originalFireColor
                        end
                    end
                end
            end
        end
    end
end)

-- 6. الحلقة الخلفية (مقسمة إلى قسمين لتخفيف الضغط على المعالج)
task.spawn(function()
    -- قسم الستريك (يشتغل كل 0.1 ثانية)
    while task.wait(0.1) do
        if streakEnabled then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                if root:FindFirstChild("Tag") and root.Tag:FindFirstChild("uiTag") and root.Tag.uiTag:FindFirstChild("User") then
                    local sreakFrame = root.Tag.uiTag.User:FindFirstChild("SreakFrame")
                    if sreakFrame then
                        local num = sreakFrame:FindFirstChild("Num")
                        if num and num:IsA("TextLabel") then
                            if not originalStreakText then
                                originalStreakText = num.Text
                                originalStreakColor = num.TextColor3
                            end
                            num.Text = "999"
                            num.TextColor3 = blueFireColor 
                        end
                        for _, child in pairs(sreakFrame:GetDescendants()) do
                            if child:IsA("ImageLabel") then
                                if not originalFireColor then
                                    originalFireColor = child.ImageColor3
                                end
                                child.ImageColor3 = blueFireColor
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    -- قسم الكاش (يشتغل كل 0.5 ثانية عشان يخفف اللاق)
    while task.wait(0.5) do
        if cashEnabled then
            for _, obj in pairs(playerGui:GetDescendants()) do
                if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and not obj:IsDescendantOf(mainFrame) and not obj:IsDescendantOf(notifyFrame) then
                    local text = obj.Text
                    if string.find(string.lower(text), "cash") or string.find(text, "%$") then
                        if not string.find(text, "999999999") then
                            if not originalCashData[obj] then
                                originalCashData[obj] = text
                            end
                            if string.find(text, "%$") then
                                obj.Text = "$999999999"
                            else
                                obj.Text = "Cash: 999999999"
                            end
                        end
                    end
                end
            end
        end
    end
end)
