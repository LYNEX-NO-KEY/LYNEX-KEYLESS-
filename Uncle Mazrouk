local function findKhaled()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            if string.find(obj.Name, "Khaled") or string.find(obj.Name, "خالد") then return obj end
            local billboard = obj:FindFirstChild("BillboardGui", true)
            if billboard then
                local textLabel = billboard:FindFirstChild("TextLabel", true)
                if textLabel and (string.find(textLabel.Text, "خالد") or string.find(textLabel.Text, "Khaled")) then return obj end
            end
        end
    end
    return nil
end

local function findBox()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            if string.find(obj.ActionText, "احمل") or string.find(obj.ObjectText, "صندوق") or string.find(obj.Parent.Name, "Crate") or string.find(obj.Parent.Name, "Supply") then
                local part = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                if part then return obj, part end
            end
        end
    end
    return nil, nil
end

local cooldownEnd = 0
local isWorking = false

-- تحديث العداد
task.spawn(function()
    while true do
        task.wait(1)
        local currentTime = os.time()
        if cooldownEnd > currentTime then
            local remaining = cooldownEnd - currentTime
            TimerLabel.Text = string.format("متبقي: %02d:%02d", math.floor(remaining/60), remaining%60)
            TimerLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        else
            TimerLabel.Text = "العداد: جاهز ✅"
            TimerLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    end
end)

ActionBtn.MouseButton1Click:Connect(function()
    if isWorking then return end
    
    local remaining = cooldownEnd - os.time()
    if remaining > 0 then
        StatusText.Text = string.format("انتظر! باقي %02d:%02d", math.floor(remaining/60), remaining%60)
        StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    isWorking = true
    StatusText.Text = "جاري التنفيذ..."
    StatusText.TextColor3 = Color3.fromRGB(255, 255, 0)
    
    task.spawn(function()
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHumanoid = myChar and myChar:FindFirstChild("Humanoid")
        if not myRoot or not myHumanoid then
            StatusText.Text = "❌ الشخصية غير محملة!"
            isWorking = false
            return
        end

        local originalPosition = myRoot.CFrame
        
        -- 1. مرزوق
        StatusText.Text = "1. جاري الانتقال لمرزوق..."
        myRoot.CFrame = CFrame.new(marzouqPosition + Vector3.new(0, 3, 0))
        task.wait(2.5)
        
        -- 2. استلام المهمة
        StatusText.Text = "2. جاري استلام المهمة..."
        local event = ReplicatedStorage:FindFirstChild("BetweenSides")
        if event and event.Remotes.Events:FindFirstChild("RamiDeliveryQuest") then
            event.Remotes.Events.RamiDeliveryQuest:FireServer("Accept")
        end
        task.wait(3.5)
        
        -- 3. الصندوق
        StatusText.Text = "3. جاري البحث عن الصندوق..."
        local boxPrompt, boxPart = findBox()
        
        if boxPart then
            myRoot.CFrame = CFrame.new(boxPart.Position + Vector3.new(0, 3, 0))
            task.wait(2)
            if boxPrompt then
                boxPrompt.HoldDuration = 0
                pcall(function() fireproximityprompt(boxPrompt) end)
                pcall(function() boxPrompt:InputHoldBegin() task.wait(0.5) boxPrompt:InputHoldEnd() end)
            end
            task.wait(1.5)
        else
            StatusText.Text = "❌ الكول داون شغال (السيرفر رفض)"
            StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
            cooldownEnd = os.time() + 900 -- بدء العداد 15 دقيقة
            isWorking = false
            return
        end
        
        -- 4. خالد والتسليم (نفس ميزة سكربتك)
        StatusText.Text = "4. جاري البحث عن خالد..."
        local khaled = findKhaled()
        
        if khaled then
            local targetPos = khaled.PrimaryPart and khaled.PrimaryPart.Position or khaled:FindFirstChild("HumanoidRootPart") and khaled.HumanoidRootPart.Position
            local closestPrompt = nil
            local shortestDistance = 30
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local pPart = obj.Parent
                    if pPart:IsA("Attachment") then pPart = pPart.Parent end
                    if pPart:IsA("BasePart") then
                        local dist = (pPart.Position - targetPos).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPrompt = obj
                        end
                    end
                end
            end
            
            if closestPrompt then
                StatusText.Text = "5. جاري التثبيت والتسليم..."
                local promptPart = closestPrompt.Parent
                if promptPart:IsA("Attachment") then promptPart = promptPart.Parent end
                
                -- خدعة التثبيت
                myHumanoid.PlatformStand = true
                local holdTime = tick()
                while tick() - holdTime < 1.2 do
                    myRoot.CFrame = promptPart.CFrame * CFrame.new(0, 1, 0)
                    myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    RunService.Heartbeat:Wait()
                end
                
                pcall(function() if type(fireproximityprompt) == "function" then fireproximityprompt(closestPrompt) end end)
                pcall(function() closestPrompt:InputHoldBegin() task.wait(0.5) closestPrompt:InputHoldEnd() end)
                pcall(function()
                    local conns = getconnections(closestPrompt.PromptButtonHoldBegan)
                    if conns then for _, c in pairs(conns) do c:Fire() end end
                end)
                
                task.wait(1.5)
                myHumanoid.PlatformStand = false
                StatusText.Text = "✅ تم التسليم بنجاح!"
            else
                StatusText.Text = "❌ لم يجد زر التسليم قرب خالد."
            end
        else
            StatusText.Text = "❌ خالد غير موجود في السيرفر!"
        end
        
        -- 5. الرجوع وبدء العداد
        task.wait(1)
        myRoot.CFrame = originalPosition
        myHumanoid.PlatformStand = false
        
        cooldownEnd = os.time() + 900 -- 15 دقيقة كول داون
        
        StatusText.Text = "✅ اكتملت المهمة! بدأ العداد."
        StatusText.TextColor3 = Color3.fromRGB(50, 255, 50)
        isWorking = false
    end)
end)
