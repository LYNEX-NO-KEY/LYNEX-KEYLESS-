local isESPActive = false
local khaledHighlight = nil
local khaledBillboard = nil

local function findKhaled()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            if string.find(obj.Name, "Khaled") or string.find(obj.Name, "خالد") then
                return obj
            end
            local billboard = obj:FindFirstChild("BillboardGui", true)
            if billboard then
                local textLabel = billboard:FindFirstChild("TextLabel", true)
                if textLabel and (string.find(textLabel.Text, "خالد") or string.find(textLabel.Text, "Khaled")) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function clearESP()
    if khaledHighlight then khaledHighlight:Destroy() khaledHighlight = nil end
    if khaledBillboard then khaledBillboard:Destroy() khaledBillboard = nil end
    isESPActive = false
    ESPGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(128, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 0, 255))
    })
    ESPText.Text = "كشف خالد (تحديد أحمر)"
end

ESPBtn.MouseButton1Click:Connect(function()
    if isESPActive then
        clearESP()
        StatusText.Text = "الحالة: الكشف مغلق"
    else
        local khaled = findKhaled()
        if khaled then
            isESPActive = true
            ESPGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 50, 50)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
            })
            ESPText.Text = "إخفاء الكشف"
            StatusText.Text = "الحالة: تم تحديد خالد (أحمر)"
            
            local head = khaled:FindFirstChild("Head") or khaled:FindFirstChild("HumanoidRootPart") or khaled.PrimaryPart
            
            khaledHighlight = Instance.new("Highlight")
            khaledHighlight.Adornee = khaled
            khaledHighlight.FillColor = Color3.fromRGB(255, 0, 0)
            khaledHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            khaledHighlight.FillTransparency = 0.3
            khaledHighlight.Parent = ScreenGui

            if head then
                khaledBillboard = Instance.new("BillboardGui")
                khaledBillboard.Adornee = head
                khaledBillboard.Size = UDim2.new(0, 100, 0, 50)
                khaledBillboard.StudsOffset = Vector3.new(0, 3, 0)
                khaledBillboard.AlwaysOnTop = true
                khaledBillboard.Parent = ScreenGui

                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = "⬇ خالد ⬇"
                textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                textLabel.TextStrokeTransparency = 0
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.TextSize = 20
                textLabel.Parent = khaledBillboard
            end
        else
            StatusText.Text = "الحالة: خالد غير موجود!"
        end
    end
end)

-- 🚀 التسليم التلقائي 
AutoDeliverBtn.MouseButton1Click:Connect(function()
    StatusText.Text = "الحالة: جاري البحث..."
    StatusText.TextColor3 = Color3.fromRGB(150, 150, 170)
    
    local khaled = findKhaled()
    if not khaled then
        StatusText.Text = "الحالة: خالد غير موجود!"
        StatusText.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end

    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar and myChar:FindFirstChild("Humanoid")
    if not myRoot or not myHumanoid then return end

    local targetPos = khaled.PrimaryPart and khaled.PrimaryPart.Position or khaled:FindFirstChild("HumanoidRootPart") and khaled.HumanoidRootPart.Position
    local closestPrompt = nil
    local shortestDistance = 30 

    -- البحث عن الزر الأقرب لخالد
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("Attachment") then parentPart = parentPart.Parent end
            if parentPart and parentPart:IsA("BasePart") then
                local dist = (parentPart.Position - targetPos).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestPrompt = obj
                end
            end
        end
    end
    
    if not closestPrompt then
        StatusText.Text = "الحالة: لم يتم العثور على زر التسليم!"
        StatusText.TextColor3 = Color3.fromRGB(255, 150, 0)
        return
    end

    local originalPosition = myRoot.CFrame
    local promptPart = closestPrompt.Parent
    if promptPart:IsA("Attachment") then promptPart = promptPart.Parent end

    StatusText.Text = "جاري النقل والثبات في الهواء..."
    StatusText.TextColor3 = Color3.fromRGB(255, 255, 255)
    
    -- 1. إيقاف حركة اللاعب مؤقتاً (عشان ما ينزل)
    myHumanoid.PlatformStand = true 

    -- 2. حلقة تكرار لتثبيت اللاعب في مكانه بالهواء لمدة ثانية كاملة (تخدع السيرفر)
    local holdTime = tick()
    while tick() - holdTime < 1.2 do
        myRoot.CFrame = promptPart.CFrame * CFrame.new(0, 1, 0)
        myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        RunService.Heartbeat:Wait()
    end

    StatusText.Text = "جاري الضغط على الزر..."
    
    -- 3. محاولة الضغط بكل الطرق المتاحة
    -- الطريقة أ: دالة دلتا الأساسية
    pcall(function()
        if type(fireproximityprompt) == "function" then
            fireproximityprompt(closestPrompt)
        end
    end)
    
    -- الطريقة ب: محاكاة ضغطة الإصبع (ممتازة للهاتف)
    pcall(function()
        closestPrompt:InputHoldBegin()
        task.wait(closestPrompt.HoldDuration > 0 and closestPrompt.HoldDuration + 0.2 or 0.5)
        closestPrompt:InputHoldEnd()
    end)

    -- الطريقة ج: تفجير الاتصال (للسيرفرات التي تتجاهل الطرق السابقة)
    pcall(function()
        local connections = getconnections(closestPrompt.PromptButtonHoldBegan)
        if connections then
            for _, conn in pairs(connections) do
                conn:Fire()
            end
        end
    end)

    task.wait(1) -- انتظار انتهاء التسليم

    -- 4. إلغاء وضع الطيران، والعودة للمكان الأصلي
    myHumanoid.PlatformStand = false
    myRoot.CFrame = originalPosition
    
    StatusText.Text = "تم التسليم والرجوع!"
    StatusText.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    if isESPActive then
        clearESP()
    end
end)

