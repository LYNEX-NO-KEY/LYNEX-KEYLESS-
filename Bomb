-- 💣 منطق السكربت (التمرير والطيران)
-- ==========================================
local currentTarget = nil
local targetHighlight = nil

-- دالة فحص القنبلة
local function hasBomb(character)
    if not character then return false end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and string.find(string.lower(child.Name), "bomb") then return true end
    end
    return false
end

-- دالة إيجاد أقرب لاعب وتحديده
local function getClosestPlayer()
    local closest, shortestDist = nil, CONFIG.DetectionRange
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and targetHum and targetHum.Health > 0 and not hasBomb(player.Character) then
                local dist = (myChar.HumanoidRootPart.Position - targetRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = player.Character
                end
            end
        end
    end
    return closest
end

-- الحلقة الرئيسية
RunService.Heartbeat:Connect(function()
    safeCall(function()
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum then return end

        -- 1️⃣ ميزة مضاد القنبلة (الطيران)
        if CONFIG.AntiBombEnabled then
            myHum.PlatformStand = true
            local targetY = myRoot.Position.Y + (CONFIG.FlyHeight * CONFIG.FlySpeed)
            if targetY < CONFIG.FlyHeight + 50 then
                myRoot.Velocity = Vector3.new(0, 50, 0)
            else
                myRoot.Velocity = Vector3.new(0, 0, 0)
            end
        else
            myHum.PlatformStand = false
        end

        -- 2️⃣ ميزة القنبلة تلقائي (التمرير)
        if CONFIG.AutoPassEnabled and not CONFIG.AntiBombEnabled and hasBomb(myChar) then
            local targetChar = getClosestPlayer()
            
            -- إدارة التحديد (ESP)
            if targetChar ~= currentTarget then
                if targetHighlight then targetHighlight:Destroy() end
                currentTarget = targetChar
                
                if currentTarget then
                    targetHighlight = Instance.new("Highlight")
                    targetHighlight.FillColor = Color3.fromRGB(255, 50, 50)
                    targetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    targetHighlight.Parent = currentTarget
                end
            end

            -- الانتقال للهدف
            if currentTarget and currentTarget:FindFirstChild("HumanoidRootPart") then
                local targetRoot = currentTarget.HumanoidRootPart
                myRoot.CFrame = myRoot.CFrame:Lerp(targetRoot.CFrame * CFrame.new(0, 0, CONFIG.TeleportOffset), 0.5)
            end
        else
            if targetHighlight then 
                targetHighlight:Destroy() 
                targetHighlight = nil 
                currentTarget = nil
            end
        end
    end)
end)

