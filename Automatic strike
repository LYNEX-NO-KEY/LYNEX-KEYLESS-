    -- أيقونات
    R1IconBg.BackgroundColor3 = theme.accent

    -- أزرار
    if not isRebinding then
        changeKbBtn.BackgroundColor3 = theme.accent
    end
    keyCapBigStroke.Color = theme.accent

    -- سكرول بار
    HelpBody.ScrollBarImageColor3 = theme.accent
    SetBody.ScrollBarImageColor3 = theme.accent

    -- تمييز دائرة اللون المختار
    for i, s in ipairs(ColorBtnStrokes) do
        if i == index then
