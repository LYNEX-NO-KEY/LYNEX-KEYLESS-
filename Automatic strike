UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if isRebinding then
        if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode ~= Enum.KeyCode.Unknown then
            CONFIG.AttackKey = input.KeyCode
            cancelRebind()
        end
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard
    and input.KeyCode == CONFIG.AttackKey then
        doManualAttack()
    end
end)

local lastAura = 0

RunService.Heartbeat:Connect(function()
    if not isAuraActive or not CombatEvent then
        previousTargets = {}
        return
    end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then return end

    local now = os.clock()
    local nearby = getNearbyPlayers()

    local currentSet = {}
    local newTargets = {}
    for _, t in ipairs(nearby) do
        local uid = t.player.UserId
        currentSet[uid] = true
        if not previousTargets[uid] then
            table.insert(newTargets, t)
        end
    end

    if #newTargets > 0 and now - lastAura >= CONFIG.InstantMinGap then
        for _, t in ipairs(newTargets) do
            CombatEvent:FireServer("Slipper")
        end
        lastAura = now
        setStatus("⚡ ضرب فوري: " .. #newTargets .. " لاعب جديد", C.success)
    elseif now - lastAura >= CONFIG.AttackSpeed then
        lastAura = now
        if #nearby > 0 then
            for _, t in ipairs(nearby) do
                CombatEvent:FireServer("Slipper")
            end
            setStatus("الهالة تضرب " .. #nearby .. " لاعب", C.accent2)
        else
            setStatus("الهالة: لا يوجد أحد بالقرب", C.textDim)
        end
    end

    previousTargets = currentSet
end)

