local function setStatus(text, color)
    StatusLabel.Text = text
    if color then
        TweenService:Create(StatusLabel, TweenInfo.new(0.2), {TextColor3 = color}):Play()
        TweenService:Create(StatusDot, TweenInfo.new(0.2), {BackgroundColor3 = color}):Play()
    end
end

local function setToggleState(on)
    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(Knob, ti, {
        Position = on and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    }):Play()
    TweenService:Create(Toggle, ti, {
        BackgroundColor3 = on and C.success or C.toggleOff
    }):Play()
    TweenService:Create(ToggleStroke, ti, {
        Transparency = on and 0.3 or 1
    }):Play()
    TweenService:Create(R2IconBg, ti, {
        BackgroundColor3 = on and C.success or C.surface2
    }):Play()
end

local function doManualAttack()
    local ok = fireAttack()
    local ti = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local color = ok and C.success or C.danger
    TweenService:Create(Row1, ti, {BackgroundColor3 = color}):Play()
    task.delay(0.15, function()
        TweenService:Create(Row1, TweenInfo.new(0.2), {BackgroundColor3 = C.surface}):Play()
    end)
    if ok then
        setStatus("تم الضرب ✓ [" .. CONFIG.AttackKey.Name .. "]", C.success)
    else
        setStatus("خطأ!", C.danger)
    end
end

local function getNearbyPlayers()
    local list = {}
    local myChar = LocalPlayer.Character
    if not myChar then return list end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 then return list end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist <= CONFIG.AttackRange then
                        table.insert(list, { player = player, hum = hum, dist = dist })
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

