local function setHotkeyDisplay()
    hkBtn.Text = State.hotkey
    hkBtn.BackgroundColor3 = C.bg3
end

hkBtn.Activated:Connect(function()
    if State.waitingForHotkey then
        State.waitingForHotkey = false
        setHotkeyDisplay()
    else
        State.waitingForHotkey = true
        hkBtn.Text = "اضغط مفتاح..."
        hkBtn.BackgroundColor3 = C.accent
    end
end)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if State.closed then return end

    if State.waitingForHotkey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local kc = input.KeyCode
            if kc == Enum.KeyCode.Escape then
                State.waitingForHotkey = false
                setHotkeyDisplay()
                return
            end
            if kc ~= Enum.KeyCode.Unknown then
                State.hotkey = kc.Name
                State.waitingForHotkey = false
                setHotkeyDisplay()
                notify("تم", "المفتاح الجديد: " .. State.hotkey)
            end
        end
        return
    end

    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard
       and input.KeyCode.Name == State.hotkey then
        local c, d = findNearest()
        if c then
            fireRope(c)
            if main.Visible then
                statusText.Text = string.format("  ✅ %s\n  📏 %.0f", c.Name, d)
                statusText.TextColor3 = C.green
            end
        else
            if main.Visible then
                statusText.Text = "  ❌ لا يوجد لاعب في المدى"
                statusText.TextColor3 = C.red
            end
        end
    end
end)

