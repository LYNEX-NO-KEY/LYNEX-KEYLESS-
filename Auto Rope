    autoRope = false, range = 60, interval = 0.25,
    target = nil, targetDist = 0,
    hotkey = "E",
    waitingForHotkey = false,
    closed = false,
}

local function findNearest()
    local myChar = LP.Character
    if not myChar then return nil, 0 end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, 0 end
    local best, bestDist = nil, State.range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            if c and c.Parent == workspace then
                local h = c:FindFirstChild("HumanoidRootPart")
                local hum = c:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 then
                    local d = (myHRP.Position - h.Position).Magnitude
                    if d < bestDist then best, bestDist = c, d end
                end
            end
        end
    end
    return best, bestDist or 0
end

local function fireRope(t)
    if not t then return false end
    return (pcall(function() RopeHandler:FireServer("Request", t) end))
end

task.spawn(function()
    while not State.closed do
        task.wait(State.interval)
        if State.autoRope then
            local c, d = findNearest()
            State.target, State.targetDist = c, d
            if c then fireRope(c) end
        end
    end
end)

