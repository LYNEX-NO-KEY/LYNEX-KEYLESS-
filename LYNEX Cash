-- ========== الإعدادات ==========
_G.CashStealer = false
_G.MaxRetries = 60
_G.RetryDelay = 0.05
_G.TeleportHeight = 3
_G.Depth = 10              -- 🆕 عمق النزول تحت الأرض

local collected = 0
local failed = 0
local activeCount = 0
local connection = nil
local activeJobs = {}
local originalCFrame = nil

-- فحص الطرق
local hasProx = pcall(function() return fireproximityprompt end)
local hasClick = pcall(function() return fireclickdetector end)
local hasTouch = pcall(function() return firetouchinterest end)

