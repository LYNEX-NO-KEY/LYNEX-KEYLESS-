-- ========== دوال ==========
local function getRoot()
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function isBlacklisted(fullName)
    local n = fullName:lower()
    for _, w in ipairs({"table","board","game","ludo","جلسة","طاولة","seat","chair","bench","lockedframe","barrier"}) do
        if n:find(w) then return true end
    end
    return false
end

local function updateUI()
    info.Text = "جمع: " .. collected .. " | فشل: " .. failed
    activeLbl.Text = "نشط: " .. activeCount
end

-- ⚡ تخزين Remotes مرة وحدة
local cachedRemotes = {}
local function findRemotes()
    cachedRemotes = {}
    for _, name in ipairs({"CashDrop","CollectCash","PickupCash","Collect","Pickup","GetCash","Cash"}) do
        local ok, remote = pcall(function() return ReplicatedStorage:FindFirstChild(name, true) end)
        if ok and remote then
            table.insert(cachedRemotes, remote)
        end
    end
    print("[Cash V15.3] Remotes found:", #cachedRemotes)
end

local function pressAll(item, char)
    if not item or not item.Parent then return end
    
    -- 1. ProximityPrompt
    local prompt = item:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if prompt and hasProx then
        pcall(function()
            if prompt.HoldDuration > 0 then prompt.HoldDuration = 0 end
            fireproximityprompt(prompt)
        end)
    end
    
    -- 2. ClickDetector
    local clicker = item:FindFirstChildOfClass("ClickDetector")
    if not clicker then
        clicker = item:FindFirstChildWhichIsA("ClickDetector", true)
    end
    if clicker and hasClick then
        pcall(fireclickdetector, clicker, 100)
    end
    
    -- 3. Touch (بس على root)
    if hasTouch and item:IsA("BasePart") and char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                firetouchinterest(root, item, 0)
                task.wait(0.01)
                firetouchinterest(root, item, 1)
            end)
        end
    end
    
    -- 4. Remote Events (من الكاش)
    for _, remote in ipairs(cachedRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(item)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(item)
            end
        end)
    end
end

local function isItemGone(item)
    if not item or not item.Parent then return true end
    if item:IsA("BasePart") and item.Transparency >= 0.95 then return true end
    return false
end

-- 🥷 الدالة الرئيسية (انتقال مرة + محاولات متكررة)
local function collectItem(item)
    if not _G.CashStealer then return end
    if activeJobs[item] then return end
    if not item or not item.Parent then return end
    if not item:IsA("BasePart") then return end
    
    activeJobs[item] = true
    activeCount += 1
    
    task.spawn(function()
        local char = player.Character
        local root = getRoot()
        if not root or not char then
            activeJobs[item] = nil
            activeCount -= 1
            return
        end
        
        -- 💾 نحفظ موقعنا واتجاهنا
        local savedCFrame = root.CFrame
        local savedRotation = savedCFrame - savedCFrame.Position
        local savedY = savedCFrame.Position.Y
        
        -- 🚀 1. انتقال فوري للفلوس (مرة وحدة)
        local targetPos = Vector3.new(item.Position.X, savedY, item.Position.Z)
        pcall(function()
            root.CFrame = CFrame.new(targetPos) * savedRotation
        end)
        
        -- ⏸️ 2. ننتظر ثانية كاملة
        task.wait(_G.WaitAtCash)
        
        -- 🔁 3. نضل نحاول نجمع
        local startTime = tick()
        while _G.CashStealer and (tick() - startTime) < _G.ItemTimeout do
            if isItemGone(item) then break end
            
            char = player.Character
            if not char then break end
            root = char:FindFirstChild("HumanoidRootPart")
            if not root then break end
            
            local currentTarget = Vector3.new(item.Position.X, savedY, item.Position.Z)
            pcall(function()
                root.CFrame = CFrame.new(currentTarget) * savedRotation
            end)
            
            pressAll(item, char)
            task.wait(_G.RetryDelay)
        end
        
        -- نحسب النتيجة
        if isItemGone(item) then
            collected += 1
        else
            failed += 1
        end
        
        -- 🏠 نرجع موقعنا الأصلي
        if _G.CashStealer then
            root = getRoot()
            if root then
                pcall(function()
                    root.CFrame = savedCFrame
                end)
            end
        end
        
        -- 🧹 تنظيف
        activeJobs[item] = nil
        activeCount -= 1
        if activeCount < 0 then activeCount = 0 end
    end)
end

-- ========== التشغيل ==========
local function start()
    findRemotes()
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CashDrop" and not isBlacklisted(obj:GetFullName()) then
            task.spawn(collectItem, obj)
            task.wait(0.05)
        end
    end
    
    connection = workspace.DescendantAdded:Connect(function(obj)
        if not _G.CashStealer then return end
        if obj.Name == "CashDrop" and not isBlacklisted(obj:GetFullName()) then
            task.wait(0.05)
            task.spawn(collectItem, obj)
        end
    end)
end

local function stop()
    _G.CashStealer = false
    
    if connection then 
        connection:Disconnect() 
        connection = nil 
    end
    
    activeJobs = {}
    activeCount = 0
    updateUI()
end

