print("[Cash V12.5] Prox:", hasProx, "| Click:", hasClick, "| Touch:", hasTouch)

-- ========== دوال ==========
local function getRoot()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function isBlacklisted(fullName)
    local n = fullName:lower()
    for _, w in ipairs({"table","board","game","ludo","جلسة","طاولة","seat","chair","bench","lockedframe","barrier"}) do
        if n:find(w) then return true end
    end
    return false
end

local function updateUI()
    info.Text = "جمع: " .. collected .. " | فشل: " .. failed
    activeLbl.Text = "نشط: " .. activeCount
end

local function pressAll(item, char)
    if not item or not item.Parent then return end
    
    local prompt = item:FindFirstChildOfClass("ProximityPrompt")
    if prompt and hasProx then
        pcall(function()
            if prompt.HoldDuration > 0 then prompt.HoldDuration = 0 end
            fireproximityprompt(prompt)
        end)
    end
    
    local clicker = item:FindFirstChildOfClass("ClickDetector")
    if clicker and hasClick then
        pcall(fireclickdetector, clicker, 100)
    end
    
    if hasTouch and item:IsA("BasePart") and char then
        pcall(function()
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                firetouchinterest(root, item, 0)
                firetouchinterest(root, item, 1)
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    firetouchinterest(part, item, 0)
                    firetouchinterest(part, item, 1)
                end
            end
        end)
    end
    
    for _, name in ipairs({"CashDrop","CollectCash","PickupCash","Collect","Pickup","GetCash","Cash"}) do
        local remote = ReplicatedStorage:FindFirstChild(name, true)
        if remote then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(item)
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(item)
                end
            end)
        end
    end
end

local function isItemGone(item)
    if not item or not item.Parent then return true end
    if item:IsA("BasePart") and item.Transparency >= 0.95 then return true end
    return false
end

-- 🆕 نزول بسيط تحت الأرض
local function goUnderground(pos)
    local root = getRoot()
    if not root then return end
    local targetPos = Vector3.new(pos.X, pos.Y - _G.Depth, pos.Z)
    root.CFrame = CFrame.new(targetPos)
end

-- 🥷 الدالة الرئيسية
local function collectItem(item)
    if not _G.CashStealer then return end
    if activeJobs[item] then return end
    if not item or not item.Parent then return end
    
    activeJobs[item] = true
    activeCount += 1
    updateUI()
    
    task.spawn(function()
        pcall(function()
            local root = getRoot()
            if not root then 
                activeJobs[item] = nil
                activeCount -= 1
                updateUI()
                return 
            end
            
            -- نحفظ موقعنا الأصلي
            local savedCFrame = originalCFrame or root.CFrame
            local savedPos = savedCFrame.Position
            
            -- 🕳️ 1. ننزل تحت الأرض أول
            goUnderground(savedPos)
            task.wait(0.03)
            
            -- 💥 2. نطير للفلوس ونجمع
            local attempt = 0
            while _G.CashStealer and attempt < _G.MaxRetries do
                if not item or not item.Parent then break end
                attempt += 1
                
                if root.Parent then
                    root.CFrame = item.CFrame + Vector3.new(0, _G.TeleportHeight, 0)
                else
                    break
                end
                
                local char = player.Character
                if char then pressAll(item, char) end
                
                task.wait(_G.RetryDelay)
                
                if isItemGone(item) then break end
            end
            
            -- نحسب النتيجة
            if item and item.Parent then
                failed += 1
            else
                collected += 1
            end
            
            -- 🕳️ 3. نرجع تحت الأرض
            if root.Parent then
                goUnderground(savedPos)
                task.wait(0.02)
            end
            
            -- 🏠 4. نرجع موقعنا الأصلي
            if root.Parent then
                root.CFrame = savedCFrame
            end
            
            updateUI()
        end)
        activeJobs[item] = nil
        activeCount -= 1
        if activeCount < 0 then activeCount = 0 end
        updateUI()
    end)
end

-- ========== التشغيل ==========
local function start()
    local root = getRoot()
    if root then originalCFrame = root.CFrame end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CashDrop" and not isBlacklisted(obj:GetFullName()) then
            task.spawn(collectItem, obj)
        end
    end
    
    connection = workspace.DescendantAdded:Connect(function(obj)
        if not _G.CashStealer then return end
        if obj.Name == "CashDrop" and not isBlacklisted(obj:GetFullName()) then
            task.wait(0.03)
            task.spawn(collectItem, obj)
        end
    end)
end

local function stop()
    if connection then connection:Disconnect() connection = nil end
    activeJobs = {}
    activeCount = 0
    updateUI()
    
    local root = getRoot()
    if root and originalCFrame then
        root.CFrame = originalCFrame
    end
end

btn.MouseButton1Click:Connect(function()
    _G.CashStealer = not _G.CashStealer
