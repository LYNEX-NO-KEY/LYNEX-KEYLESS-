        btn.Text = "ON"
        btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        status.Text = "شغال ✅"
        status.TextColor3 = Color3.fromRGB(0, 255, 100)
        start()
    else
        btn.Text = "OFF"
        btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        status.Text = "متوقف ⛔"
        status.TextColor3 = Color3.fromRGB(200, 200, 200)
        stop()
    end
end)

