--  🔄 SMART EVENTS (Debounced)
-- ═══════════════════════════════════════════════
local refreshQueued = false
local function queueSync()
    if refreshQueued then return end
    refreshQueued = true
    task.delay(0.2, function()
        refreshQueued = false
        syncList(searchBox.Text)
    end)
end

Players.ChildAdded:Connect(function(child)
    if child:IsA("Player") and child ~= LocalPlayer then
        -- استنى الـ DisplayName يجهز
        task.wait(0.3)
        queueSync()
    end
end)

Players.ChildRemoved:Connect(function(child)
    if child:IsA("Player") then
        if spectating == child then
            stopSpectate()
        end
        -- احذف الصف فوراً (بدون debounce)
        local entry = rowCache[child.Name]
        if entry then
            entry.row:Destroy()
            rowCache[child.Name] = nil
        end
        queueSync()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if spectating == player then
        stopSpectate()
        updateAllButtons()
    end
end)

