local function refreshCardStats()
    local plr = Spectate.target
    if not plr then return end

    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if hum and root then
        hpText.Text = string.format("HP %d", math.floor(hum.Health))
        local pct = hum.Health / math.max(hum.MaxHealth, 1)
        hpText.TextColor3 = (pct > 0.3) and T.ok or T.warn

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            distText.Text = string.format("%d م", math.floor((myRoot.Position - root.Position).Magnitude))
        else
            distText.Text = "— م"
        end

        local toolName = "لا شيء"
        for _, ch in ipairs(char:GetChildren()) do
            if ch:IsA("Tool") then
                toolName = ch.Name
                break
            end
        end
        toolText.Text = toolName
    else
        hpText.Text = "HP —"
        hpText.TextColor3 = T.sub
        distText.Text = "— م"
        toolText.Text = "—"
    end
end

task.spawn(function()
    while gui.Parent do
        task.wait(0.1)
        if Spectate.target then
            pcall(refreshCardStats)
        end
    end
end)

