local L = {
    vw = 1280, vh = 720,
    compact = false, sideCard = false,
    panelW = 370, panelH = 500, cardW = 260,
}

local function recompute()
    local cam = workspace.CurrentCamera
    local vp = (cam and cam.ViewportSize) or Vector2.new(1280, 720)
    L.vw = math.max(vp.X, 240)
    L.vh = math.max(vp.Y, 240)

    L.compact = (L.vw < 780) or (L.vh < 470)
    L.sideCard = (L.vw >= 700) or (L.vw > L.vh)

    -- نفس طول وعرض الواجهة القديمة، مع تقليص فقط لو الشاشة أضيق منها
    L.panelW = math.min(L.compact and PANEL_W_MB or PANEL_W_PC, L.vw - PAD * 2)
    L.panelH = math.min(L.compact and PANEL_H_MB or PANEL_H_PC, L.vh - PAD * 2)

    if L.sideCard then
        L.cardW = math.clamp(math.floor(L.vw * 0.20), 214, 252)
    else
        L.cardW = math.min(L.vw - PAD * 2, 320)
    end
end

