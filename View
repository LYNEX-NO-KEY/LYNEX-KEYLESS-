--  ✨ RED ANIMATED BORDER — Consolidated (1 loop)
-- ═══════════════════════════════════════════════
local animatedStrokes = {}

local function addRedAnimatedBorder(frame, baseThickness)
    baseThickness = baseThickness or 2
    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Red
    stroke.Thickness = baseThickness
    stroke.Transparency = 0.15
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = frame

    local inner = Instance.new("UIStroke")
    inner.Color = Theme.Red2
    inner.Thickness = 1
    inner.Transparency = 0.6
    inner.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    inner.Parent = frame

    table.insert(animatedStrokes, {stroke = stroke, inner = inner, base = baseThickness})
    return stroke
end

-- ✅ حلقة وحدة لكل الحدود (بدل 3 حلقات)
task.spawn(function()
    while gui.Parent do
        RunService.Heartbeat:Wait()
        local pulse = (math.sin(tick() * 2.5) + 1) / 2
        for i = #animatedStrokes, 1, -1 do
            local e = animatedStrokes[i]
            if not e.stroke.Parent then
                table.remove(animatedStrokes, i)
            else
                e.stroke.Transparency = 0.1 + pulse * 0.55
                e.stroke.Thickness = e.base + pulse * 2
                e.inner.Transparency = 0.5 + pulse * 0.4
            end
        end
    end
end)

