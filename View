-- ───────────── Orbit Camera Input ─────────────
UserInputService.InputChanged:Connect(function(input, gpe)
    if not spectating then return end
    if isDraggingGUI then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if gpe then return end
        orbitYaw = orbitYaw - input.Delta.X * orbitSens
        orbitPitch = math.clamp(orbitPitch + input.Delta.Y * orbitSens, math.rad(-75), math.rad(80))
    end

    if input.UserInputType == Enum.UserInputType.Touch then
        if gpe then return end
        if not isTouchRotating then return end
        orbitYaw = orbitYaw - input.Delta.X * orbitSens * 1.3
        orbitPitch = math.clamp(orbitPitch + input.Delta.Y * orbitSens * 1.3, math.rad(-75), math.rad(80))
    end

    if input.UserInputType == Enum.UserInputType.MouseWheel then
        orbitDistance = math.clamp(orbitDistance - input.Position.Z * 2, 4, 40)
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not spectating then return end
    if input.UserInputType == Enum.UserInputType.Touch and not gpe and not isDraggingGUI then
        isTouchRotating = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        isTouchRotating = false
    end
end)

