-- ══════════════════════════════════════════════════════════════════
--  17) التحكم بالكاميرا — ماوس + لمس (بما فيه قرصة إصبعين)
-- ══════════════════════════════════════════════════════════════════
local touches = {}   -- [InputObject] = Vector3
local touchCount = 0
local pinchPrev = nil

local function firstTwoTouches()
    local a, b
    for input, pos in pairs(touches) do
        if not a then
            a = pos
        elseif not b then
            b = pos
            break
        end
    end
    return a, b
end

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        if not touches[input] then touchCount = touchCount + 1 end
        touches[input] = input.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        if touches[input] then touchCount = math.max(touchCount - 1, 0) end
        touches[input] = nil
        if touchCount < 2 then pinchPrev = nil end
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if not Spectate.target then return end
    if isDraggingGUI then return end
    if UserInputService:GetFocusedTextBox() then return end

    -- ماوس: حركة حرة للكاميرا
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if gpe then return end
        Spectate.yaw = Spectate.yaw - input.Delta.X * Spectate.sens
        Spectate.pitch = clampPitch(Spectate.pitch + input.Delta.Y * Spectate.sens)
        return
    end

    -- عجلة الماوس: زوم
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if gpe then return end
        Spectate.dist = math.clamp(
            Spectate.dist - input.Position.Z * 1.6,
            Spectate.minDist, Spectate.maxDist
        )
        return
    end

    -- لمس
    if input.UserInputType == Enum.UserInputType.Touch then
        if touches[input] then
            touches[input] = input.Position
        end
        if gpe then return end

        local a, b = firstTwoTouches()
        if a and b then
            -- قرصة إصبعين = زوم
            local d = (a - b).Magnitude
            if pinchPrev then
                local delta = d - pinchPrev
                Spectate.dist = math.clamp(
                    Spectate.dist - delta * 0.055,
                    Spectate.minDist, Spectate.maxDist
                )
            end
            pinchPrev = d
        else
            -- إصبع واحد = تدوير حر
            pinchPrev = nil
            Spectate.yaw = Spectate.yaw - input.Delta.X * Spectate.sens * 1.35
            Spectate.pitch = clampPitch(Spectate.pitch + input.Delta.Y * Spectate.sens * 1.35)
        end
    end
end)

