-- إبقاء البطاقة داخل الشاشة
function keepCardOnScreen()
    if not cardMoved then return end
    local pos = card.Position
    local ax = card.AnchorPoint.X
    local ay = card.AnchorPoint.Y
    local w = card.AbsoluteSize.X
    local h = card.AbsoluteSize.Y
    if w <= 0 or h <= 0 then w, h = L.cardW, CARD_H end

    local xOff = pos.X.Offset
    local yOff = pos.Y.Offset
    local xScale = pos.X.Scale
    local yScale = pos.Y.Scale

    local baseX = xScale * L.vw
    local baseY = yScale * L.vh

    local minX = -baseX + 4 + w * ax
    local maxX = L.vw - baseX - 4 - w * (1 - ax)
    local minY = -baseY + 4 + h * ay
    local maxY = L.vh - baseY - 4 - h * (1 - ay)

    xOff = math.clamp(xOff, minX, math.max(minX, maxX))
    yOff = math.clamp(yOff, minY, math.max(minY, maxY))

    card.Position = UDim2.new(xScale, xOff, yScale, yOff)
end

