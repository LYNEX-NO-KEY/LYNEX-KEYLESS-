    if not isMobile then
        watchBtn.MouseEnter:Connect(function()
            if watchBtn.Text == "مشاهدة" then
                TweenService:Create(watchBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent2}):Play()
            else
                TweenService:Create(watchBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Danger2}):Play()
            end
        end)
        watchBtn.MouseLeave:Connect(function()
            if watchBtn.Text == "مشاهدة" then
                TweenService:Create(watchBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play()
            else
                TweenService:Create(watchBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Danger}):Play()
            end
        end)
    end

    row:SetAttribute("PlayerTarget", player.Name)
    return row, watchBtn
end

-- ───────────── Spectate Logic ─────────────
local function getHeldTool(char)
    if not char then return "لا شيء" end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then return child.Name end
    end
    return "لا شيء"
end

local function updateSpectateInfoStats()
    if not spectating then return end
    local char = spectating.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local p = root.Position
    siPosition.Text = string.format("📍 %d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z))

    if LocalPlayer.Character then
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            siDistance.Text = string.format("📏 %d م", math.floor((myRoot.Position - p).Magnitude))
        else
            siDistance.Text = "📏 —"
        end
    else
        siDistance.Text = "📏 —"
    end

    if hum then
        local hp = math.floor(hum.Health)
        local mx = math.floor(hum.MaxHealth)
        siHealth.Text = string.format("❤️ %d / %d", hp, mx)
        local pct = hum.Health / math.max(hum.MaxHealth, 1)
        if pct > 0.6 then
            siHealth.TextColor3 = Theme.Green
        elseif pct > 0.3 then
            siHealth.TextColor3 = Theme.Yellow
        else
            siHealth.TextColor3 = Theme.Danger
        end
    else
        siHealth.Text = "❤️ —"
        siHealth.TextColor3 = Theme.SubText
    end

    siTool.Text = "🔧 " .. getHeldTool(char)
end

local function stopSpectate()
    spectating = nil
    isTouchRotating = false
    RunService:UnbindFromRenderStep("ForceSpectateCamera")
    spectateInfo.Visible = false
    subtitle.Text = "اسحب لتدوير الكاميرا"
    subtitle.TextColor3 = Theme.SubText

    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = hum
        end
    end
end

local function spectate(player)
    if not player or player == LocalPlayer then return end
    spectating = player

    orbitYaw = 0
    orbitPitch = math.rad(20)
    orbitDistance = 14

    siAvatar.Image = "rbxthumb://type=Avatar&id="..player.UserId.."&w=420&h=420"
    siDisplayName.Text = player.DisplayName or player.Name
    siUsername.Text = "@"..player.Name
    siUserId.Text = "ID: "..tostring(player.UserId)
    siPosition.Text = "📍 —"
    siDistance.Text = "📏 —"
    siHealth.Text = "❤️ —"
    siTool.Text = "🔧 —"
    spectateInfo.Visible = true

    subtitle.Text = "تشاهد: @" .. player.Name
    subtitle.TextColor3 = Theme.Red2

    pcall(function() RunService:UnbindFromRenderStep("ForceSpectateCamera") end)

    RunService:BindToRenderStep("ForceSpectateCamera", Enum.RenderPriority.Camera.Value + 10, function()
        if not spectating then return end
        local char = spectating.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root then return end

        Camera.CameraType = Enum.CameraType.Scriptable
        local targetPos = root.Position + Vector3.new(0, 2, 0)

        local cosP = math.cos(orbitPitch)
        local finalYaw = orbitYaw
        if followMode then
            local look = root.CFrame.LookVector
            finalYaw = math.atan2(look.X, look.Z) + orbitYaw
        end

        local offset = Vector3.new(
            math.sin(finalYaw) * cosP,
            math.sin(orbitPitch),
            math.cos(finalYaw) * cosP
        ) * orbitDistance

        Camera.CFrame = CFrame.lookAt(targetPos + offset, targetPos)
        updateSpectateInfoStats()
    end)
end

-- ───────────── Update Buttons ─────────────
local function updateAllButtons()
    for _, row in ipairs(list:GetChildren()) do
        if row:IsA("Frame") then
            local btn = row:FindFirstChildOfClass("TextButton")
            local plrName = row:GetAttribute("PlayerTarget")
            if btn and plrName then
                local isSpectatingThis = spectating and spectating.Name == plrName
                if isSpectatingThis then
                    btn.Text = "إيقاف"
                    btn.BackgroundColor3 = Theme.Danger
                else
                    btn.Text = "مشاهدة"
                    btn.BackgroundColor3 = Theme.Accent
                end

                local hi = row:FindFirstChild("RowHighlight")
                if isSpectatingThis then
                    if not hi then
                        local s = Instance.new("UIStroke")
                        s.Name = "RowHighlight"
                        s.Color = Theme.Red
                        s.Thickness = 2
                        s.Transparency = 0.2
                        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                        s.Parent = row
                        task.spawn(function()
                            while s.Parent do
                                local pulse = (math.sin(tick() * 4) + 1) / 2
                                s.Transparency = 0.15 + pulse * 0.5
                                RunService.Heartbeat:Wait()
                            end
                        end)
                    end
                else
                    if hi then hi:Destroy() end
                end
            end
        end
    end
end

-- ═══════════════════════════════════════════════
--  🚀 INCREMENTAL SYNC (Zero-Lag)
-- ═══════════════════════════════════════════════
local rowCache = {} -- [playerName] = {row, btn, player}

local function shouldShow(plr, filter)
    if plr == LocalPlayer then return false end
    if filter == "" then return true end
    local lname = plr.Name:lower()
    local ldname = (plr.DisplayName or ""):lower()
    return lname:find(filter, 1, true) ~= nil
        or ldname:find(filter, 1, true) ~= nil
end

local function syncList(filter)
    filter = (filter or ""):lower()

    -- 1️⃣ احذف الصفوف اللي لازم تختفي
    local toRemove = {}
    for name, entry in pairs(rowCache) do
        local plr = entry.player
        -- لو اللاعب خرج من اللعبة أو ما عاد يطابق الفلتر
        if not plr or plr.Parent ~= Players or not shouldShow(plr, filter) then
            table.insert(toRemove, name)
        end
    end
    for _, name in ipairs(toRemove) do
        rowCache[name].row:Destroy()
        rowCache[name] = nil
    end

    -- 2️⃣ أضف صفوف جديدة + رتّب الموجود
    local order = 0
    local visibleCount = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if shouldShow(plr, filter) then
            visibleCount += 1
            local entry = rowCache[plr.Name]
            if not entry then
                -- ✅ أضف صف جديد (مرة وحدة بس)
                local ok, row, btn = pcall(makeRow, plr, order)
                if ok and row and btn then
                    btn.MouseButton1Click:Connect(function()
                        if spectating == plr then
                            stopSpectate()
                            updateAllButtons()
                        else
                            spectate(plr)
                            updateAllButtons()
                        end
                    end)
                    rowCache[plr.Name] = {row = row, btn = btn, player = plr}
                end
            else
                -- ✅ موجود — فقط حدّث الترتيب
                entry.row.LayoutOrder = order
            end
            order += 1
        end
    end

    -- 3️⃣ رسالة "لا يوجد لاعبين"
    local emptyLabel = list:FindFirstChild("EmptyLabel")
    if visibleCount == 0 then
        if not emptyLabel then
            local empty = Instance.new("TextLabel")
            empty.Name = "EmptyLabel"
            empty.Size = UDim2.new(1, 0, 0, 40)
            empty.BackgroundTransparency = 1
            empty.Text = "لا يوجد لاعبين"
            empty.Font = Enum.Font.Gotham
            empty.TextSize = isMobile and 12 or 14
            empty.TextColor3 = Theme.SubText
            empty.LayoutOrder = 999999
            empty.Parent = list
        end
    else
        if emptyLabel then emptyLabel:Destroy() end
    end

    updateAllButtons()
end

