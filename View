--  15) المزامنة الجزئية (Zero-Lag)
-- ══════════════════════════════════════════════════════════════════
local function shouldShow(plr, filter)
    if plr == LocalPlayer then return false end
    if filter == "" then return true end
    local dn = plr.DisplayName
    if dn and string.find(string.lower(dn), filter, 1, true) then return true end
    return string.find(string.lower(plr.Name), filter, 1, true) ~= nil
end

local function updateOnline()
    local n = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then n = n + 1 end
    end
    onlineLabel.Text = tostring(n) .. " لاعب متصل"
end

local function syncList(filter)
    filter = string.lower(filter or "")

    -- 1) احذف غير المطابق
    local remove = {}
    for name, e in pairs(rowCache) do
        if not e.player or e.player.Parent ~= Players or not shouldShow(e.player, filter) then
            table.insert(remove, name)
        end
    end
    for _, name in ipairs(remove) do
        local e = rowCache[name]
        if e and e.row then e.row:Destroy() end
        rowCache[name] = nil
    end

    -- 2) أضف الجديد ورتّب
    local order = 0
    local visible = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if shouldShow(plr, filter) then
            visible = visible + 1
            local e = rowCache[plr.Name]
            if not e then
                local ok, entry = pcall(makeRow, plr, order)
                if ok and entry then
                    entry.btn.MouseButton1Click:Connect(function()
                        if Spectate.target == plr then
                            stopSpectate()
                        else
                            spectate(plr)
                        end
                    end)
                    rowCache[plr.Name] = entry
                end
            else
                e.row.LayoutOrder = order
                if e.player ~= plr then
                    e.player = plr
                    e.nameLbl.Text = plr.DisplayName or plr.Name
                    e.userLbl.Text = "@" .. plr.Name
                end
            end
            order = order + 1
        end
    end

    -- 3) عدّادات + حالة فراغ
    resultCount.Text = tostring(visible)
    updateOnline()

    local empty = list:FindFirstChild("Empty")
    if visible == 0 then
        if not empty then
            local e = new("TextLabel", {
                Name = "Empty",
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundTransparency = 1,
                Text = (filter ~= "") and "لا يوجد لاعب بهذا البحث" or "لا يوجد لاعبين",
                Font = F_MAIN,
                TextSize = 12,
                TextColor3 = T.sub,
                LayoutOrder = 999999,
                ZIndex = 8,
            }, list)
        end
    elseif empty then
        empty:Destroy()
    end

    updateButtons()
end

-- تحديث نقاط الحالة فقط (خفيف)
task.spawn(function()
    while gui.Parent do
        task.wait(0.9)
        for _, e in pairs(rowCache) do
            local plr = e.player
            local char = plr and plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
