--  11) كاميرا حرة (بدون أوربت)
-- ══════════════════════════════════════════════════════════════════
local function clampPitch(v)
    return math.clamp(v, math.rad(-78), math.rad(82))
end

local function resetCamera()
    Spectate.yaw = 0
    Spectate.pitch = math.rad(18)
    Spectate.dist = 14
end

local function renderCamera()
    local plr = Spectate.target
    if not plr then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    local targetPos
    if root and hum and hum.Health > 0 then
        targetPos = root.Position + Vector3.new(0, 2.2, 0)
        Spectate.lastPos = targetPos
        Spectate.deadToast = false
        cardDot.BackgroundColor3 = (hum.Health / math.max(hum.MaxHealth, 1) > 0.3) and T.ok or T.warn
    else
        targetPos = Spectate.lastPos
        if not Spectate.deadToast then
            Spectate.deadToast = true
            cardDot.BackgroundColor3 = T.dead
            toast("اللاعب خارج اللعب — الكاميرا تبقى بمكانها", 2.6)
        end
    end
    if not targetPos then return end

    local cp = math.cos(Spectate.pitch)
    local offset = Vector3.new(
        math.sin(Spectate.yaw) * cp,
        math.sin(Spectate.pitch),
        math.cos(Spectate.yaw) * cp
    ) * Spectate.dist

    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(targetPos + offset, targetPos)
end

local function spectate(plr)
    if not plr or plr == LocalPlayer then return end

    Spectate.target = plr
    Spectate.lastPos = nil
    Spectate.deadToast = false
    resetCamera()

    cardAvatar.Image = "rbxthumb://type=Avatar&id=" .. plr.UserId .. "&w=420&h=420"
    cardName.Text = plr.DisplayName or plr.Name
    cardUser.Text = "@" .. plr.Name
    cardId.Text = "ID · " .. tostring(plr.UserId)
    hpText.Text = "HP —"
    distText.Text = "— م"
    toolText.Text = "—"
    cardDot.BackgroundColor3 = T.ok

    -- إظهار البطاقة بأنيميشن
    local p, a = cardPos()
    card.AnchorPoint = a
    card.Visible = true
    local slide = (a.Y == 1) and UDim2.new(p.X.Scale, p.X.Offset, 1, -PAD + 18)
        or UDim2.new(p.X.Scale, p.X.Offset - 18, p.Y.Scale, p.Y.Offset)
    card.Position = slide
    TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = p,
    }):Play()

    pcall(function()
        RunService:UnbindFromRenderStep("LYNEX_SpectateCamera")
    end)
    RunService:BindToRenderStep("LYNEX_SpectateCamera", Enum.RenderPriority.Camera.Value + 10, renderCamera)

    toast("اسحب/حرّك لتدوير الكاميرا · عجلة أو إصبعين للزوم", 3.4)
    updateButtons()
end

function stopSpectate(silent)
    if not Spectate.target then return end
    Spectate.target = nil
    Spectate.lastPos = nil
    Spectate.deadToast = false

    pcall(function()
        RunService:UnbindFromRenderStep("LYNEX_SpectateCamera")
    end)

    card.Visible = false

    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then cam.CameraSubject = hum end
        end
    end

    if not silent then
        toast("رجعت لكاميرتك", 1.6)
    end

    -- اللاعب رجع لكاميرتك: أظهر زر القائمة لو البانل مسكّر
    if not panel.Visible then
        fab.Visible = true
    end

    updateButtons()
end

