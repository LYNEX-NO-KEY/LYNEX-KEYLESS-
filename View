local toastToken = 0
local function toast(msg, dur)
    toastToken = toastToken + 1
    local token = toastToken
    toastLabel.Text = msg
    toastLabel.Visible = true
    TweenService:Create(toastLabel, TweenInfo.new(0.18), {
        BackgroundTransparency = 0.06,
        TextTransparency = 0,
    }):Play()
    task.delay(dur or 2.2, function()
        if token ~= toastToken then return end
        TweenService:Create(toastLabel, TweenInfo.new(0.35), {
            BackgroundTransparency = 1,
            TextTransparency = 1,
        }):Play()
        task.delay(0.4, function()
            if token == toastToken then toastLabel.Visible = false end
        end)
    end)
end

