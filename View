local function fontOf(name, fallback)
    local ok, f = pcall(function()
        return Enum.Font[name]
    end)
    if ok and f then return f end
    return Enum.Font[fallback or "Gotham"]
end

local F_BOLD  = fontOf("GothamBold")
local F_SEMI  = fontOf("GothamSemibold", "GothamBold")
local F_MAIN  = fontOf("Gotham", "SourceSans")
local F_MED   = fontOf("GothamMedium", "Gotham")
local F_TITLE = T.mono and fontOf("Code", "RobotoMono") or F_BOLD

local function new(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            if k ~= "Parent" then
                inst[k] = v
            end
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(parent, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function pad(parent, t, b, l, r)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    }, parent)
end

-- ── أيقونات مرسومة (بدل الإيموجي غير الموثوق) ───────────────────
local function iconHolder(parent, size)
    local baseZ = 0
    if parent and parent:IsA("GuiObject") then baseZ = parent.ZIndex end
    return new("Frame", {
        Name = "Icon",
        BackgroundTransparency = 1,
        ZIndex = baseZ + 1,
        Size = UDim2.fromOffset(size, size),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
    }, parent)
end

local function bar(parent, w, h, cx, cy, rot, color)
    local b = new("Frame", {
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(w, h),
        Position = UDim2.new(0.5, cx, 0.5, cy),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Rotation = rot or 0,
    }, parent)
    corner(b, math.min(w, h) / 2)
    return b
end

local function drawIcon(kind, parent, size, color)
    local holder = iconHolder(parent, size)
    local s = size

    if kind == "cross" then
        bar(holder, s * 0.62, 2, 0, 0, 45, color)
        bar(holder, s * 0.62, 2, 0, 0, -45, color)

    elseif kind == "plus" then
        bar(holder, s * 0.6, 2.2, 0, 0, 0, color)
        bar(holder, 2.2, s * 0.6, 0, 0, 0, color)

    elseif kind == "minus" then
        bar(holder, s * 0.6, 2.2, 0, 0, 0, color)

    elseif kind == "search" then
        local ring = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(s * 0.62, s * 0.62),
            Position = UDim2.new(0.5, -s * 0.07, 0.5, -s * 0.07),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(ring, s * 0.31)
        stroke(ring, color, 2, 0)
        bar(holder, s * 0.34, 2, s * 0.26, s * 0.26, 45, color)

    elseif kind == "copy" then
        local back = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(s * 0.56, s * 0.56),
            Position = UDim2.new(0.5, -s * 0.12, 0.5, -s * 0.12),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(back, s * 0.14)
        stroke(back, color, 1.6, 0)
        local front = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(s * 0.56, s * 0.56),
            Position = UDim2.new(0.5, s * 0.12, 0.5, s * 0.12),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(front, s * 0.14)
        stroke(front, color, 1.6, 0)

    elseif kind == "info" then
        bar(holder, 2.4, s * 0.4, 0, s * 0.1, 0, color)
        local dot = new("Frame", {
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(2.6, 2.6),
            Position = UDim2.new(0.5, 0, 0.5, -s * 0.26),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(dot, 2)

    elseif kind == "eye" then
        local lid = new("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(s * 0.92, s * 0.58),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(lid, s * 0.29)
        stroke(lid, color, 2, 0)
        local pupil = new("Frame", {
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(s * 0.24, s * 0.24),
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, holder)
        corner(pupil, s)

    elseif kind == "reset" then
        new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = "⟲",
            Font = F_BOLD,
            TextSize = s,
            TextColor3 = color,
        }, holder)
    end

    return holder
end

-- يعيد تلوين كل أجزاء الأيقونة (بدون tween — فوري وخفيف)
local function paintIcon(holder, color)
    if not holder or not holder.Parent then return end
    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("Frame") then
            d.BackgroundColor3 = color
        elseif d:IsA("TextLabel") then
            d.TextColor3 = color
        elseif d:IsA("UIStroke") then
            d.Color = color
        end
    end
end

local hasMouse = UserInputService.MouseEnabled

local function hover(btn, bgNormal, bgHover, icon, colNormal, colHover)
    if not hasMouse then return end
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = bgHover }):Play()
        if icon then paintIcon(icon, colHover or T.text) end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = bgNormal }):Play()
        if icon then paintIcon(icon, colNormal or T.sub) end
    end)
end

-- زر أيقونة دائري/مربع
local function iconButton(parent, px, kind, color, bg)
    local b = new("TextButton", {
        Size = UDim2.fromOffset(px, px),
        BackgroundColor3 = bg or T.surf2,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
    }, parent)
    corner(b, math.floor(px / 2))
    local ico = drawIcon(kind, b, math.floor(px * 0.46), color or T.sub)
    hover(b, bg or T.surf2, T.accent2, ico, color or T.sub, T.text)
    return b, ico
end

