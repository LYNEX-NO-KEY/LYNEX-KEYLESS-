-- [[ سكربت إخفاء بيانات اللاعب V7 - نسخة محسّنة للاداء ]] --
-- التعديلات:
-- 1. استبدال RenderStepped (60Hz) بمعالجة أحداث + استطلاع 2Hz للـ UI
-- 2. إصلاح LocalTransparencyModifier على Decal/Texture
-- 3. عدم إخفاء أزرار السكربت نفسه
-- 4. تنظيف الجداول عند تغيير الشخصية (منع تسريب الذاكرة)
-- 5. تخطي المعالجة لما تكون كل المفاتيح مطفية

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Settings = {
    HideSelfBody = false,
    HideSelfName = false,
    HideSelfFlags = false,
    HideMoney = false,
    HideDate = false,
}

-- جداول الحالة الأصلية
local originalBodyState = {}       -- [BasePart/Decal/Texture] = original
local originalBillboardState = {}  -- [GuiObject في الشخصية] = Visible الأصلي
local originalUIState = {}         -- [GuiObject في PlayerGui] = Visible الأصلي

-- ============================================================
--                        الواجهة
-- ============================================================

