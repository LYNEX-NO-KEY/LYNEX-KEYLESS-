Title.BorderSizePixel = 0
Title.Text = "اخفاء بيانات اللاعب"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 16
Title.Parent = MainFrame
Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 10)

local MinimizeBtn = Instance.new("TextButton")
MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
MinimizeBtn.Position = UDim2.new(1, -32, 0, 2.5)
MinimizeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
MinimizeBtn.Text = "➖"
MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
MinimizeBtn.Font = Enum.Font.SourceSansBold
MinimizeBtn.TextSize = 18
MinimizeBtn.Parent = Title
Instance.new("UICorner", MinimizeBtn).CornerRadius = UDim.new(0, 6)

local ButtonContainer = Instance.new("ScrollingFrame")
ButtonContainer.Size = UDim2.new(1, -10, 1, -45)
ButtonContainer.Position = UDim2.new(0, 5, 0, 40)
ButtonContainer.BackgroundTransparency = 1
ButtonContainer.ScrollBarThickness = 2
ButtonContainer.Parent = MainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Padding = UDim.new(0, 6)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Parent = ButtonContainer

-- تصغير / تكبير
local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        ButtonContainer.Visible = false
        MainFrame.Size = UDim2.new(0, 200, 0, 35)
        MinimizeBtn.Text = "➕"
    else
        ButtonContainer.Visible = true
        MainFrame.Size = UDim2.new(0, 200, 0, 270)
        MinimizeBtn.Text = "➖"
    end
end)

-- ============================================================
--               دوال معالجة الجسم والبيانات
-- ============================================================

-- معالجة جزء واحد (BasePart / Decal / Texture)
local function ApplyBodyHiddenToInstance(obj)
    if obj:IsA("BasePart") then
        if originalBodyState[obj] == nil then
            originalBodyState[obj] = obj.LocalTransparencyModifier
        end
        obj.LocalTransparencyModifier = 1
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if originalBodyState[obj] == nil then
            originalBodyState[obj] = obj.Transparency
        end
        obj.Transparency = 1
    end
end

local function RestoreAllBody()
    for obj, orig in pairs(originalBodyState) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = orig
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = orig
            end
        end
    end
    originalBodyState = {}
end

local function ApplyBodyHidden()
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        ApplyBodyHiddenToInstance(obj)
    end
end

-- معالجة BillboardGui / SurfaceGui (اسم + علم)
local function ApplyBillboardToGui(gui)
    for _, child in ipairs(gui:GetDescendants()) do
        if child:IsA("TextLabel") then
            if Settings.HideSelfName then
                if originalBillboardState[child] == nil then
                    originalBillboardState[child] = child.Visible
                end
                child.Visible = false
            elseif originalBillboardState[child] ~= nil then
                child.Visible = originalBillboardState[child]
                originalBillboardState[child] = nil
            end
        elseif child:IsA("ImageLabel") then
            if Settings.HideSelfFlags then
                if originalBillboardState[child] == nil then
                    originalBillboardState[child] = child.Visible
                end
                child.Visible = false
            elseif originalBillboardState[child] ~= nil then
                child.Visible = originalBillboardState[child]
                originalBillboardState[child] = nil
            end
        end
    end
end

local function ApplyBillboardHidden()
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            ApplyBillboardToGui(obj)
        end
    end
end

local function RestoreAllBillboard()
    for obj, orig in pairs(originalBillboardState) do
        if obj and obj.Parent then
            obj.Visible = orig
        end
    end
    originalBillboardState = {}
end

-- تحديث شامل للشخصية (يتنادى فقط عند تغيير زر أو دخول شخصية)
local function ProcessCharacterUpdate()
    if Settings.HideSelfBody then
        ApplyBodyHidden()
    elseif next(originalBodyState) ~= nil then
        RestoreAllBody()
    end

    if Settings.HideSelfName or Settings.HideSelfFlags then
        ApplyBillboardHidden()
    elseif next(originalBillboardState) ~= nil then
        RestoreAllBillboard()
    end
end

-- ============================================================
--          ربط الأحداث بالشخصية (بدل الفريم-بفريم)
-- ============================================================

local charConnections = {}

local function OnCharacterDescendantAdded(obj)
    if Settings.HideSelfBody then
        ApplyBodyHiddenToInstance(obj)
    end
    if Settings.HideSelfName or Settings.HideSelfFlags then
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            ApplyBillboardToGui(obj)
        end
    end
end

local function SetupCharacter(char)
    -- فصل الاتصالات القديمة
    for _, c in ipairs(charConnections) do
        if c then c:Disconnect() end
    end
    charConnections = {}
    -- تصفير الجداول (أجزاء الشخصية القديمة صارت محذوفة)
    originalBodyState = {}
    originalBillboardState = {}
    -- ربط جديد
    table.insert(charConnections, char.DescendantAdded:Connect(OnCharacterDescendantAdded))
    -- تطبيق الإعدادات الحالية (تأخير بسيط لضمان تحميل الشخصية)
    task.delay(0.4, ProcessCharacterUpdate)
end

LocalPlayer.CharacterAdded:Connect(SetupCharacter)
if LocalPlayer.Character then
    SetupCharacter(LocalPlayer.Character)
end

-- ============================================================
--        معالجة واجهة اللعبة (الفلوس / التاريخ) - 2Hz
-- ============================================================

local function ProcessUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") and not gui:IsDescendantOf(ScreenGui) then
            local text = gui.Text:lower()

            local hide = false
            if Settings.HideMoney and (
                text:find("cash") or text:find("money")
                or text:find("فلوس") or text:find("كاش")
            ) then
                hide = true
            elseif Settings.HideDate and (
                text:find("am") or text:find("pm")
                or text:match("%d+/%d+/%d+")
                or text:match("%d+:%d+")
            ) then
                hide = true
            end

            if hide then
                if originalUIState[gui] == nil then
                    originalUIState[gui] = gui.Visible
                end
                gui.Visible = false
            elseif originalUIState[gui] ~= nil then
                gui.Visible = originalUIState[gui]
                originalUIState[gui] = nil
            end
        end
    end
end

-- استطلاع خفيف: مرتين بالثانية فقط
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.5)
        if (Settings.HideMoney or Settings.HideDate) or next(originalUIState) ~= nil then
            pcall(ProcessUI)
        end
    end
end)

-- ============================================================
--                       الأزرار
-- ============================================================

local function CreateToggleButton(name, text, layoutOrder, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = text .. " : اطفاء"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.LayoutOrder = layoutOrder
    btn.Parent = ButtonContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local isToggled = false
    btn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        if isToggled then
            btn.Text = text .. " : تشغيل"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(30, 60, 30)
        else
            btn.Text = text .. " : اطفاء"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        end
        callback(isToggled)
    end)
end

CreateToggleButton("HideBodyBtn", "إخفاء جسمي", 1, function(state)
    Settings.HideSelfBody = state
    ProcessCharacterUpdate()
end)

CreateToggleButton("HideNameBtn", "إخفاء اسمي", 2, function(state)
    Settings.HideSelfName = state
    ProcessCharacterUpdate()
end)

CreateToggleButton("HideFlagBtn", "إخفاء علمي/ستريكي", 3, function(state)
    Settings.HideSelfFlags = state
    ProcessCharacterUpdate()
end)

CreateToggleButton("HideMoneyBtn", "إخفاء الفلوس/الكاش", 4, function(state)
    Settings.HideMoney = state
    pcall(ProcessUI)
end)

CreateToggleButton("HideDateBtn", "إخفاء التاريخ/الوقت", 5, function(state)
    Settings.HideDate = state
    pcall(ProcessUI)
end)

