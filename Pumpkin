-- 5. منطق الجمع (نفس السكربت اللي ضبط)
-- ==========================================
local function getExactPumpkins()
    local parts = {}
    local halloweenFolder = Workspace:FindFirstChild("Halloween")
    if halloweenFolder then
        for _, obj in ipairs(halloweenFolder:GetDescendants()) do
            if obj:IsA("BasePart") and (string.find(obj.Name, "Copyright") or obj.Name == "Cash") then
                table.insert(parts, obj)
            end
        end
    end
    return parts
end

local isRunning = false
local loopThread = nil
local savedPosition = nil

local function stopScript()
    if not isRunning then return end
    isRunning = false
    
    if loopThread then
        task.cancel(loopThread)
        loopThread = nil
    end
    
    ActionText.Text = "بدء الجمع 👻"
    ActionGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 70, 0))
    })
    BtnStroke.Color = ColorPumpkin
    StatusLabel.Text = "تم الإيقاف والرجوع..."
    StatusDot.BackgroundColor3 = ColorRed
    
    if savedPosition and player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = savedPosition
            StatusLabel.Text = "رجعت لمكانك 🎃"
            task.wait(1)
            StatusLabel.Text = "الوضع الليلي... جاهز 🦇"
            StatusDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        end
    end
    savedPosition = nil
end

player.CharacterAdded:Connect(function()
    if isRunning then stopScript() end
end)

ActionBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopScript()
    else
        isRunning = true
        ActionText.Text = "إيقاف والرجوع 🛑"
        ActionGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 50, 50)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 20, 20))
        })
        BtnStroke.Color = ColorRed
        
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        savedPosition = myRoot.CFrame
        StatusDot.BackgroundColor3 = ColorGreen
        StatusLabel.Text = "جاري جمع الكاش..."
        
        loopThread = task.spawn(function()
            while isRunning do
                local pumpkins = getExactPumpkins()
                
                if #pumpkins == 0 then
                    StatusLabel.Text = "ما في يقطين حالياً..."
                    task.wait(2)
                else
                    for i, part in ipairs(pumpkins) do
                        if not isRunning then break end
                        StatusLabel.Text = "جمع " .. i .. " من " .. #pumpkins
                        
                        myRoot.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))
                        task.wait(0.2) 
                        myRoot.CFrame = CFrame.new(part.Position)
                        
                        pcall(function()
                            firetouchinterest(myRoot, part, 0)
                            task.wait(0.1)
                            firetouchinterest(myRoot, part, 1)
                        end)
                        task.wait(0.3)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

