local entries = {}

local function currentQuery()
    return (searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")):lower()
end

local function highlight(str, q)
    if q == "" then return esc(str) end
    local matches = {}
    local init = 1
    while true do
        local s, e = string.find(string.lower(str), string.lower(q), init, true)
        if not s then break end
        table.insert(matches, {s, e})
        init = e + 1
    end
    if #matches == 0 then return esc(str) end
    
    local out = {}
    local lastIndex = 1
    for _, match in ipairs(matches) do
        local s, e = match[1], match[2]
        table.insert(out, esc(string.sub(str, lastIndex, s - 1)))
        table.insert(out, '<font color="#' .. Theme.accent2:ToHex() .. '"><b>' .. esc(string.sub(str, s, e)) .. '</b></font>')
        lastIndex = e + 1
    end
    table.insert(out, esc(string.sub(str, lastIndex)))
    return table.concat(out)
end

local function renderText(e, q)
    -- إصلاح الاسم الفارغ
    local safeName = (e.name and e.name ~= "") and e.name or "System"
    local nm = '<font color="' .. (e.color or "#FFFFFF") .. '"><b>' .. esc(safeName) .. '</b></font>'
    local tm = '  <font color="#6B6B80" size="9">[' .. e.time .. ']</font>'
    
    local body = e.system and ('<i><font color="#9A9AB0">' .. esc(e.message) .. '</font></i>') or highlight(e.message, q)
    return nm .. tm .. "\n" .. body
end

local function scrollToBottom()
    task.defer(function()
        if scroll and scroll.Parent then
            scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
        end
    end)
end

local function addMessage(displayName, message, isSystem, userId)
    if not message or message == "" then return end
    local q = currentQuery()
    
    -- التأكد من أن الاسم ليس فارغاً
    if not displayName or displayName == "" then 
        displayName = isSystem and "System" or "Player" 
    end

    local e = {
        name = displayName, message = message, time = os.date("%H:%M"),
        color = isSystem and "#8A8A9A" or colorFor(displayName), system = isSystem,
    }

    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, 0, 0, 0)
    msgFrame.AutomaticSize = Enum.AutomaticSize.Y
    msgFrame.BackgroundColor3 = Theme.msgBg
    msgFrame.BackgroundTransparency = 0.2
    msgFrame.BorderSizePixel = 0
    msgFrame.Parent = scroll
    createCorner(msgFrame, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Position = UDim2.new(0, 4, 0, 4)
    lbl.Size = UDim2.new(1, -(MAX_MSG_AVATAR + 10), 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 10
    lbl.TextColor3 = Theme.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.TextWrapped = true
    lbl.RichText = true
    lbl.Text = renderText(e, q)
    lbl.Parent = msgFrame

    local av = Instance.new("ImageLabel")
    av.AnchorPoint = Vector2.new(1, 0)
    av.Position = UDim2.new(1, -4, 0, 4)
    av.Size = UDim2.fromOffset(MAX_MSG_AVATAR, MAX_MSG_AVATAR)
    av.BackgroundColor3 = Theme.header
    av.BorderSizePixel = 0
    av.Parent = msgFrame
    createCorner(av, 999)
    createStroke(av, Theme.accent, 1, 0.5)

    local onlineDot = Instance.new("Frame")
    onlineDot.AnchorPoint = Vector2.new(1, 1)
    onlineDot.Position = UDim2.new(1, 1, 1, 1)
    onlineDot.Size = UDim2.fromOffset(6, 6)
    onlineDot.BackgroundColor3 = isSystem and Theme.sub or Theme.online
    onlineDot.BorderSizePixel = 0
    onlineDot.Parent = av
    createCorner(onlineDot, 999)
    createStroke(onlineDot, Theme.msgBg, 1, 0)

    if userId and not isSystem then
        task.spawn(function()
            local img = getAvatar(userId)
            if img and av.Parent then av.Image = img end
        end)
    end

    e.frame, e.label = msgFrame, lbl
    entries[#entries + 1] = e

    local hay = (e.name .. " " .. e.message):lower()
    msgFrame.Visible = (q == "" or hay:find(q, 1, true) ~= nil)

    if #entries > 250 then
        local oldE = table.remove(entries, 1)
        if oldE and oldE.frame then oldE.frame:Destroy() end
    end

    scrollToBottom()
end

local function applyFilter()
    local q = currentQuery()
    for _, e in ipairs(entries) do
        local hay = (e.name .. " " .. e.message):lower()
        e.frame.Visible = (q == "" or hay:find(q, 1, true) ~= nil)
        e.label.Text = renderText(e, q)
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

--=========== التقاط الشات (تم الإصلاح هنا) ============
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(msg)
        local src = msg.TextSource
        if not src then
            -- رسالة من النظام (ليس لاعب)
            addMessage("System", msg.Text, true, nil)
        else
            -- رسالة من لاعب
            local nm = src.DisplayName
            if not nm or nm == "" then nm = src.Name end
            if not nm or nm == "" then nm = "Player_" .. tostring(src.UserId) end
            addMessage(nm, msg.Text, false, src.UserId)
        end
    end)
else
    -- الشات القديم
    local function hook(p)
        p.Chatted:Connect(function(m) 
            local nm = p.DisplayName or p.Name or "Player"
            addMessage(nm, m, false, p.UserId) 
        end)
    end
    for _, p in ipairs(Players:GetPlayers()) do hook(p) end
    Players.PlayerAdded:Connect(hook)
end

