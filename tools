-- سكربت يحاكي أمر tools في Infinite Yield
if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(0.5)

local player = game.Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")

-- تحديد الخدمات التي يبحث فيها Infinite Yield
local servicesToSearch = {
    game:GetService("ReplicatedStorage"),
    game:GetService("Lighting")
}

local copiedCount = 0

for _, service in ipairs(servicesToSearch) do
    for _, obj in ipairs(service:GetDescendants()) do
        if obj:IsA("Tool") then
            local success, clone = pcall(function()
                return obj:Clone()
            end)
            
            if success and clone then
                clone.Parent = backpack
                copiedCount = copiedCount + 1
            end
        end
    end
end

print(string.format("تم نسخ %d أداة من ReplicatedStorage و Lighting.", copiedCount))
