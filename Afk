-- Update loop
RunService.Heartbeat:Connect(function()
    local now = tick()

    runtimeVal.Text = fmt(now - runtimeStart)

    local idle = now - lastActivity
    idleVal.Text = fmt(idle)

    if idle >= AFK_THRESHOLD and not afkDetectedAt then
        afkDetectedAt = lastActivity + AFK_THRESHOLD
    end

    if afkDetectedAt then
        afkVal.Text = fmt(now - afkDetectedAt)
        afkVal.TextColor3 = C.red
        idleVal.TextColor3 = Color3.fromRGB(253, 186, 116)
    else
        afkVal.Text = "لا يوجد"
        afkVal.TextColor3 = Color3.fromRGB(134, 239, 172)
        idleVal.TextColor3 = Color3.fromRGB(167, 243, 208)
    end

    local idlePct = math.clamp(idle / AFK_THRESHOLD, 0, 1)
    progressFill.Size = UDim2.new(idlePct, 0, 1, 0)
    if idlePct < 0.5 then
        progressFill.BackgroundColor3 = C.green
    elseif idlePct < 0.8 then
        progressFill.BackgroundColor3 = C.yellow
    else
        progressFill.BackgroundColor3 = C.red
    end
    progressLbl.Text = string.format("اقتراب الطرد: %d%%", math.floor(idlePct * 100))

    actionLbl.Text = "الحركة: " .. currentAction

    -- Sync shadow
    shadow.Position = MainFrame.Position + UDim2.new(0, 4, 0, 6)
    shadow.Size = MainFrame.Size
end)

