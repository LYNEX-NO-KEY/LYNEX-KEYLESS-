end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2
    or t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Touch then
        registerActivity()
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        registerActivity()
    end
end)

-- Camera rotation
RunService:BindToRenderStep("AntiAFK_RotateCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not isEnabled then return end
    local cam = workspace.CurrentCamera
    if cam then
        cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(ROTATION_SPEED * dt), 0)
    end
end)

-- Movement via CFrame
local function interpolateTo(targetCF, duration)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local startCF = root.CFrame
    local startTime = tick()
    while true do
        if not isEnabled then
            local r = char:FindFirstChild("HumanoidRootPart")
            if r then r.CFrame = targetCF end
            return
        end
        local t = (tick() - startTime) / duration
        if t >= 1 then
            local r = char:FindFirstChild("HumanoidRootPart")
            if r then r.CFrame = targetCF end
            return
        end
        local r = char:FindFirstChild("HumanoidRootPart")
        if not r then return end
        r.CFrame = startCF:Lerp(targetCF, t)
        RunService.RenderStepped:Wait()
    end
end

local function doMovementCycle()
    if not isEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end

    local originCF = root.CFrame
    local forwardCF = originCF + originCF.LookVector * MOVE_STUDS

    currentAction = "🚶 للأمام"
    interpolateTo(forwardCF, MOVE_DURATION)
    task.wait(0.15)
    if not isEnabled then return end

    currentAction = "↩️ عودة"
    interpolateTo(originCF, MOVE_DURATION)
    task.wait(0.15)
    currentAction = "—"
end

task.spawn(function()
    while ScreenGui.Parent do
        if isEnabled then
            pcall(doMovementCycle)
            task.wait(1.5)
        else
            task.wait(0.5)
        end
    end
end)

