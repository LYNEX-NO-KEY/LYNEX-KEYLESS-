task.spawn(function()
    while true do
        task.wait(0.2)
        for player, labels in pairs(playerUI) do
            if labels.status and labels.status.Parent then
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hum and hrp then
                        if hum.Health <= 0 then
                            labels.status.Text = "💀 ميت"
                            labels.status.TextColor3 = Color3.fromRGB(255, 0, 0)
                        else
                            local isMoving = hum.MoveDirection.Magnitude > 0 or hrp.AssemblyLinearVelocity.Magnitude > 2
                            if isMoving then
                                labels.status.Text = "🏃 يتحرك"
                                labels.status.TextColor3 = Color3.fromRGB(255, 150, 0)
                            else
                                labels.status.Text = "🧟 واقف"
                                labels.status.TextColor3 = Color3.fromRGB(150, 255, 100)
                            end
                        end
                        
                        if isPlayerInSafeZone(player) then
                            labels.safe.Text = "🛡️ منطقة آمنة"
                            labels.safe.TextColor3 = Color3.fromRGB(0, 255, 255)
                        else
                            labels.safe.Text = "❌ ليس بآمن"
                            labels.safe.TextColor3 = Color3.fromRGB(200, 100, 100)
                        end

                        if isPlayerFlying(player) then
