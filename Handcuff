-- أنميشن تبديل الصفحات (Slide)
local function togglePage(page)
    local pages = {ContentFrame, InfoFrame, SettingsFrame}
    for _, p in ipairs(pages) do
        if p == page then
            p.Visible = true
            p.Position = UDim2.new(0, 8, 0, 35) -- يبدأ من الأسفل شوي
            TweenService:Create(p, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 8, 0, 28)}):Play()
        else
            p.Visible = false
        end
    end
end

