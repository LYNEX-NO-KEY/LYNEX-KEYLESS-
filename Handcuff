    if listDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - listDragStart
        listFrame.Position = UDim2.new(listStartPos.X.Scale, listStartPos.X.Offset + delta.X, listStartPos.Y.Scale, listStartPos.Y.Offset + delta.Y)
    end
end)

local function applyFilter()
    local searchText = string.lower(searchBox.Text)
    clearSearchBtn.Visible = (#searchText > 0)
    for _, card in ipairs(scrollingFrame:GetChildren()) do
        if card:IsA("Frame") then
            local playerName = string.lower(card.Name)
            if searchText == "" then
                card.Visible = true
                card.LayoutOrder = 1 
            else
                local matchPos = string.find(playerName, searchText)
                if matchPos then
                    card.Visible = true
                    card.LayoutOrder = matchPos == 1 and 0 or 1
                else
                    card.Visible = false
                end
            end
        end
    end
end
searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)
clearSearchBtn.MouseButton1Click:Connect(function() searchBox.Text = ""; applyFilter() end)

local safeZoneParts = {}
local function scanForSafeZones()
    table.clear(safeZoneParts)
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = string.lower(part.Name)
            if string.find(name, "safe") or string.find(name, "protect") or string.find(name, "barrier") or string.find(name, "spawn") then
                table.insert(safeZoneParts, part)
            end
        end
    end
end
local function isPlayerInSafeZone(targetPlayer)
    local char = targetPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if targetPlayer:GetAttribute("SafeZone") or targetPlayer:GetAttribute("Protected") or targetPlayer:GetAttribute("InSafeZone") then return true end
    for _, part in ipairs(safeZoneParts) do
        if part and part.Parent then
            local relativePos = part.CFrame:PointToObjectSpace(hrp.Position)
            local halfSize = part.Size / 2
            if math.abs(relativePos.X) <= halfSize.X and math.abs(relativePos.Y) <= halfSize.Y and math.abs(relativePos.Z) <= halfSize.Z then
                return true
            end
        end
    end
    return false
end
scanForSafeZones()
workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("BasePart") then
        local name = string.lower(descendant.Name)
        if string.find(name, "safe") or string.find(name, "protect") or string.find(name, "barrier") or string.find(name, "spawn") then
            table.insert(safeZoneParts, descendant)
        end
    end
end)

local function isPlayerFlying(targetPlayer)
    local char = targetPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local raycastResult = workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0), raycastParams)
    local distanceToGround = raycastResult and (hrp.Position.Y - raycastResult.Position.Y) or 100
    if distanceToGround > 15 then return true end
    if hrp.AssemblyLinearVelocity.Y > 15 and hum:GetState() ~= Enum.HumanoidStateType.Jumping then return true end
    return false
end

-- دالة الانتقال والكلبشة (تم إصلاحها لضمان الضغط)
local function teleportGrabAndReturn(targetPlayer, clickedButton)
    if not throwRemote then return end
    local oldText = clickedButton.Text
    clickedButton.Text = "..." 
    clickedButton.BackgroundColor3 = Color3.fromRGB(100, 50, 0)

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local equippedTool = myChar and myChar:FindFirstChildOfClass("Tool")

    if not equippedTool then
        clickedButton.Text = "جهز أداة!"
        task.wait(1.5)
        clickedButton.Text = oldText
        clickedButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) 
        return
    end

    local targetChar = targetPlayer.Character
    if not myHRP or not targetChar then return end
    local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetHRP or not targetHum or targetHum.Health <= 0 then return end

    -- 1. حفظ الموقع الأصلي
    local originalCFrame = myHRP.CFrame
    
    -- 2. الانتقال أمام اللاعب مباشرة (توجيه الكاميرا نحوه)
    -- CFrame.lookAt يضعنا على مسافة 2 متر أمام اللاعب وننظر إليه
    local teleportPos = targetHRP.Position + targetHRP.CFrame.LookVector * 2
    myHRP.CFrame = CFrame.lookAt(teleportPos, targetHRP.Position)
    
    -- 3. انتظار السيرفر ليتعرف على موقعنا الجديد (مهم جداً)
    task.wait(0.5) 

    -- 4. إرسال الأمر وتفعيل الأداة عدة مرات لضمان الاستجابة
    for i = 1, 5 do
        -- تفعيل الأداة
        pcall(function() equippedTool:Activate() end)
        
        -- إرسال الأمر للسيرفر
        pcall(function() throwRemote:FireServer("Request", targetPlayer) end)
        
        -- انتظار بسيط بين كل محاولة
        task.wait(0.2) 
    end

    -- 5. انتظار أخير قبل العودة
    task.wait(0.3)
    
    -- 6. العودة للموقع الأصلي
    if myHRP and myHRP.Parent then 
        myHRP.CFrame = originalCFrame 
    end
    
    clickedButton.Text = oldText
    clickedButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) 
end

