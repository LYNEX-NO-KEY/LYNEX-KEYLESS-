-- ═══════════════ القفز اللانهائي ═══════════════

local function updateInfJumpBtn()
    if infJump then
        infJumpBtn.Text = "قفز لانهائي: مفعل"
        TweenService:Create(infJumpBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(55, 170, 90),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        infJumpStroke.Color = Color3.fromRGB(90, 220, 130)
    else
        infJumpBtn.Text = "قفز لانهائي: معطل"
        TweenService:Create(infJumpBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(45, 55, 75),
            TextColor3 = Color3.fromRGB(200, 200, 220)
        }):Play()
        infJumpStroke.Color = Color3.fromRGB(80, 90, 120)
    end
end

infJumpBtn.MouseButton1Click:Connect(function()
    infJump = not infJump
    updateInfJumpBtn()
end)

infJumpBtn.MouseEnter:Connect(function()
    if not infJump then
        TweenService:Create(infJumpBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(60, 75, 100)
        }):Play()
    end
end)

infJumpBtn.MouseLeave:Connect(function()
    if not infJump then
        TweenService:Create(infJumpBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(45, 55, 75)
        }):Play()
    end
end)

RunService.Stepped:Connect(function()
    if not infJump or flying then return end
    if not character or not character.Parent then return end

    if UIS:IsKeyDown(Enum.KeyCode.Space) then
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- ═══════════════ حركة الطيران ═══════════════

RunService.RenderStepped:Connect(function()
    if not flying then return end

    if not character or not character.Parent
        or not hrp or not hrp.Parent
        or not bv or not bv.Parent
        or not bg or not bg.Parent then
        stopFly()
        return
    end

    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        stopFly()
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local dir = Vector3.zero

    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.R) then dir += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.T) then dir -= Vector3.new(0, 1, 0) end

    if dir.Magnitude > 0 then
        dir = dir.Unit
    end

    bv.Velocity = dir * flySpeed
    bg.CFrame = cam.CFrame
end)

-- ═══════════════ اختصارات لوحة المفاتيح ═══════════════

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end

    -- F: طيران
    if input.KeyCode == Enum.KeyCode.F then
        if flying then stopFly() else startFly() end

    -- G: قفز لانهائي
    elseif input.KeyCode == Enum.KeyCode.G then
        infJump = not infJump
        updateInfJumpBtn()

    -- E: تفعيل سرعة المشي (عند عدم الطيران)
    elseif input.KeyCode == Enum.KeyCode.E then
        if not flying then
            activateSpeedBoost()
        end

    -- Q: إرجاع سرعة المشي (عند عدم الطيران)
    elseif input.KeyCode == Enum.KeyCode.Q then
        if not flying then
            deactivateSpeedBoost()
        end
    end
end)

