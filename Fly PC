-- ═══════════════ الحالات ═══════════════

local flying = false
local flySpeed = 80
local infJump = false

local character, hrp

-- حالة سرعة المشي
local speedBoostActive = false
local originalWalkSpeed = 16

local bv, bg

local function refreshChar()
    character = player.Character or player.CharacterAdded:Wait()
    local hum = character:WaitForChild("Humanoid")
    hrp = character:WaitForChild("HumanoidRootPart")
    return hum
end

-- ═══════════════ نظام الطيران ═══════════════

local function cleanupFly()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
end

local function stopFly()
    flying = false
    cleanupFly()
    toggleBtn.Text = "تشغيل الطيران"
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(55, 170, 90)
    }):Play()
    toggleStroke.Color = Color3.fromRGB(90, 220, 130)
end

local function startFly()
    if flying then return end
    local hum = refreshChar()
    if not hum or hum.Health <= 0 then return end
    cleanupFly()

    bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.P = 1250
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.Name = "FlyGyro"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 9000
    bg.D = 500
    bg.CFrame = workspace.CurrentCamera.CFrame
    bg.Parent = hrp

    flying = true
    toggleBtn.Text = "إيقاف الطيران"
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Color3.fromRGB(200, 65, 65)
    }):Play()
    toggleStroke.Color = Color3.fromRGB(240, 90, 90)
end

-- ═══════════════ نظام سرعة المشي ═══════════════

local function setSpeedBoostVisual(active)
    if active then
        walkLabel.TextColor3 = Color3.fromRGB(120, 220, 140)
        TweenService:Create(walkBox, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(40, 90, 55)
        }):Play()
        walkBoxStroke.Color = Color3.fromRGB(90, 220, 130)
    else
        walkLabel.TextColor3 = Color3.fromRGB(180, 180, 210)
        TweenService:Create(walkBox, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        }):Play()
        walkBoxStroke.Color = Color3.fromRGB(70, 70, 100)
    end
end

local function activateSpeedBoost()
    if speedBoostActive then return end
    if flying then return end
    if not character or not character.Parent then return end

    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local n = tonumber(walkBox.Text)
    if not n or n <= 0 or n > 500 then
        walkBox.Text = "50"
        n = 50
    end

    originalWalkSpeed = hum.WalkSpeed
    hum.WalkSpeed = n
    speedBoostActive = true
    setSpeedBoostVisual(true)
end

local function deactivateSpeedBoost()
    if not speedBoostActive then return end
    if not character or not character.Parent then
        speedBoostActive = false
        setSpeedBoostVisual(false)
        return
    end

    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = originalWalkSpeed
    end

    speedBoostActive = false
    setSpeedBoostVisual(false)
end

-- ═══════════════ ربط التهيئة بالشخصية ═══════════════

refreshChar()

player.CharacterAdded:Connect(function(c)
    stopFly()
    speedBoostActive = false
    setSpeedBoostVisual(false)

    character = c
    hrp = nil

    local hum = c:WaitForChild("Humanoid")
    hrp = c:WaitForChild("HumanoidRootPart")

    hum.Died:Connect(function()
        stopFly()
        speedBoostActive = false
        setSpeedBoostVisual(false)
    end)
end)

if character then
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Died:Connect(function()
            stopFly()
            speedBoostActive = false
            setSpeedBoostVisual(false)
        end)
    end
end

player.CharacterRemoving:Connect(function()
    stopFly()
    speedBoostActive = false
    setSpeedBoostVisual(false)
    character = nil
    hrp = nil
end)

