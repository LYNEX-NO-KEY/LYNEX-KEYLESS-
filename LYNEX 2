local PlayersGroup = Tabs.Players:AddLeftGroupbox("Players Online")

_G.Spectating = nil

local function StopSpectate()
    local camera = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = char.Humanoid
    end
    _G.Spectating = nil
    Library:Notify("Stopped spectating", 2)
end

local function StartSpectate(player)
    local camera = workspace.CurrentCamera
    local targetChar = player.Character
    if targetChar and targetChar:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = targetChar.Humanoid
        _G.Spectating = player
        Library:Notify("Spectating @" .. player.Name, 2)
    else
        Library:Notify("Cannot spectate @" .. player.Name, 2)
    end
end

local PlayerItems = {}

local function CreatePlayerItems(player)
    if PlayerItems[player] then return end

    local specToggle = PlayersGroup:AddToggle("Spec_" .. player.UserId, {
        Text = "Spectate: @" .. player.Name,
        Default = false,
        Callback = function(state)
            if state then
                if _G.Spectating and _G.Spectating ~= player then
                    local oldToggle = Options["Spec_" .. _G.Spectating.UserId]
                    if oldToggle then oldToggle:SetValue(false) end
                end
                StartSpectate(player)
            else
                if _G.Spectating == player then StopSpectate() end
            end
        end
    })

    local tpBtn = PlayersGroup:AddButton("Teleport to @" .. player.Name, function()
        local char = LocalPlayer.Character
        local targetChar = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            Library:Notify("Teleported to @" .. player.Name, 3)
        else
            Library:Notify("Cannot teleport", 3)
        end
    end)

    PlayerItems[player] = { toggle = specToggle, button = tpBtn }
end

local function RemovePlayerItems(player)
    if PlayerItems[player] then
        pcall(function() PlayerItems[player].toggle:Remove() end)
        pcall(function() PlayerItems[player].button:Remove() end)
        PlayerItems[player] = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then CreatePlayerItems(player) end
end

Players.PlayerAdded:Connect(function(player)
    task.wait(0.5)
    CreatePlayerItems(player)
end)

Players.PlayerRemoving:Connect(function(player)
    RemovePlayerItems(player)
end)

