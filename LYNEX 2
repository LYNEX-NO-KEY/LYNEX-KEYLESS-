_G.TeleportHeight = 3
_G.Depth = 10

local collected = 0
local failed = 0
local activeCount = 0
local cashConnection = nil
local activeJobs = {}
local originalCFrame = nil

local hasProx = pcall(function() return fireproximityprompt end)
local hasClick = pcall(function() return fireclickdetector end)
local hasTouch = pcall(function() return firetouchinterest end)

print("[Cash] Prox:", hasProx, "| Click:", hasClick, "| Touch:", hasTouch)

local function updateUI()
    if Options.CollectedLabel then
        Options.CollectedLabel:Set("تم الجمع: " .. collected .. " | فشل: " .. failed)
    end
    if Options.ActiveLabel then
        Options.ActiveLabel:Set("نشط: " .. activeCount)
    end
end

local function isBlacklisted(fullName)
    local n = fullName:lower()
    for _, w in ipairs({"table","board","game","ludo","جلسة","طاولة","seat","chair","bench","lockedframe","barrier","player","character","humanoid"}) do
        if n:find(w) then return true end
    end
    return false
end

local function isCashItem(obj)
    if not obj or not obj.Parent then return false end
    if isBlacklisted(obj:GetFullName()) then return false end
    
    local name = obj.Name:lower()
    
    if name == "cashdrop" then return true end
    if name:find("cash") and not name:find("cashier") then return true end
    if name:find("money") and not name:find("moneybag") then return true end
    if name:find("coin") then return true end
    if name:find("drop") and obj:IsA("BasePart") then return true end
    if name:find("pickup") then return true end
    
    return false
end

local function pressAll(item, char)
    if not item or not item.Parent then return end
    
    local prompt = item:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        prompt = item:FindFirstChild("ProximityPrompt", true)
    end
    if prompt and hasProx then
        pcall(function()
            if prompt.HoldDuration > 0 then prompt.HoldDuration = 0 end
            fireproximityprompt(prompt)
        end)
    end
    
    local clicker = item:FindFirstChildOfClass("ClickDetector")
    if not clicker then
        clicker = item:FindFirstChild("ClickDetector", true)
    end
    if clicker and hasClick then
        pcall(fireclickdetector, clicker, 100)
    end
    
    if hasTouch and item:IsA("BasePart") and char then
        pcall(function()
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                firetouchinterest(root, item, 0)
                firetouchinterest(root, item, 1)
            end
        end)
    end
    
    for _, name in ipairs({"CashDrop","CollectCash","PickupCash","Collect","Pickup","GetCash","Cash","ClaimCash","TakeCash"}) do
        local remote = ReplicatedStorage:FindFirstChild(name, true)
        if remote then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(item)
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(item)
                end
            end)
        end
    end
end

local function isItemGone(item)
    if not item or not item.Parent then return true end
    if item:IsA("BasePart") and item.Transparency >= 0.95 then return true end
    return false
end

local function findAllCash()
    local cashItems = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCashItem(obj) then
            table.insert(cashItems, obj)
        end
    end
    print("[Cash] Found items:", #cashItems)
    return cashItems
end

local function collectItem(item)
    if not _G.CashStealer then return end
    if activeJobs[item] then return end
    if not item or not item.Parent then return end
    
    activeJobs[item] = true
    activeCount += 1
    updateUI()
    
    task.spawn(function()
        pcall(function()
            local root = GetRoot(LocalPlayer)
            if not root then 
                activeJobs[item] = nil
                activeCount -= 1
                updateUI()
                return 
            end
            
            local savedCFrame = originalCFrame or root.CFrame
            
            local attempt = 0
            while _G.CashStealer and attempt < _G.MaxRetries do
                if not item or not item.Parent then break end
                attempt += 1
                
                local itemPos = item.Position
                local targetPos = itemPos + Vector3.new(0, _G.TeleportHeight, 0)
                
                if root.Parent then
                    root.CFrame = CFrame.new(targetPos)
                else
                    break
                end
                
                local char = LocalPlayer.Character
                if char then pressAll(item, char) end
                
                task.wait(_G.RetryDelay)
                
                if isItemGone(item) then break end
            end
            
            if item and item.Parent then
                failed += 1
            else
                collected += 1
            end
            
            if root.Parent then
                root.CFrame = savedCFrame
            end
            
            updateUI()
        end)
        activeJobs[item] = nil
        activeCount -= 1
        if activeCount < 0 then activeCount = 0 end
        updateUI()
    end)
end

local function startCash()
    local root = GetRoot(LocalPlayer)
    if root then originalCFrame = root.CFrame end
    
    local cashItems = findAllCash()
    for _, obj in ipairs(cashItems) do
        task.spawn(collectItem, obj)
    end
    
    cashConnection = workspace.DescendantAdded:Connect(function(obj)
        if not _G.CashStealer then return end
        if isCashItem(obj) then
            task.wait(0.05)
            task.spawn(collectItem, obj)
        end
    end)
end

local function stopCash()
    if cashConnection then cashConnection:Disconnect() cashConnection = nil end
    activeJobs = {}
    activeCount = 0
    updateUI()
    
    local root = GetRoot(LocalPlayer)
    if root and originalCFrame then
        root.CFrame = originalCFrame
    end
end

